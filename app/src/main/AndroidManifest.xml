<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to show the "Hors ligne" banner. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 and later ask before showing notifications (lot 8). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- « Mettre à jour » installs the new version from the app (PRD, récit 6 quater). Android asks
         the member once, in the settings, and checks the signature of every APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FamiliaApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Familia">
        <!-- Notifications sent by the Cloud Functions while the app is closed. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="events" />

        <service
            android:name=".core.notifications.FamiliaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Lets the camera app write the picture taken for a profile photo (PRD, récit 3 bis).
             No camera permission: the camera app takes the picture, not Familia. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.photos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_paths" />
        </provider>

        <!-- Result of an in-app update install. -->
        <receiver
            android:name=".feature.update.InstallResultReceiver"
            android:exported="false" />

        <!-- singleTop: a tapped notification reuses the open app instead of stacking a second one.
             No launcher entry of its own: the 3 icon aliases below open it. It stays exported so
             that a shortcut made before the aliases still opens the app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- The 3 app icons, chosen in Famille › Réglages › Apparence (AppIcon). Only one is
             enabled at a time; Olivier is the default. -->
        <activity-alias
            android:name=".IconOlivier"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconTerre"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_terre"
            android:roundIcon="@mipmap/ic_launcher_terre_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconOr"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_or"
            android:roundIcon="@mipmap/ic_launcher_or_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
