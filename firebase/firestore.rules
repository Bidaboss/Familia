rules_version = '2';

// Familia security rules. They apply the PRD "Droits par profil" on the server, so nothing changes
// even if someone bypasses the app. Each lot adds the rules for the collections it introduces.
// Data model: docs/data-model.md. Tests: firebase/tests (run against the Firestore emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Who is calling -------------------------------------------------------------------------

    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Emails are stored lower-case; Google may return any casing.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailIndexPath(email) {
      return /databases/$(database)/documents/memberEmails/$(email);
    }

    // A member is recognised by their verified Google address, which works before the first
    // sign-in has linked a Firebase UID to the member document.
    function isMember() {
      return hasVerifiedEmail() && exists(emailIndexPath(myEmail()));
    }

    function myMemberId() {
      return get(emailIndexPath(myEmail())).data.memberId;
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    // The admin principal (PRD, récit 1 ter): named in config/family, which only the GitHub
    // workflow « Créer le premier admin » writes. Nobody can remove this role from the app.
    function familyConfigPath() {
      return /databases/$(database)/documents/config/family;
    }

    function ownerId() {
      return exists(familyConfigPath()) ? get(familyConfigPath()).data.ownerMemberId : null;
    }

    // Without config/family the get fails: nobody is admin principal, and an "isOwner() || …"
    // falls back on the other rights.
    function isOwner() {
      return isMember() && get(familyConfigPath()).data.ownerMemberId == myMemberId();
    }

    // A chef de famille (the member flag isAdmin) manages the members and events of their own
    // household only (PRD, « Périmètre d'un chef de famille », carte DEV-8).
    function isChefOf(householdId) {
      return isMember()
        && get(memberPath(myMemberId())).data.isAdmin == true
        && get(memberPath(myMemberId())).data.householdId == householdId;
    }

    // The admin principal, or a chef de famille of [householdId].
    function managesHousehold(householdId) {
      return isOwner() || isChefOf(householdId);
    }

    // A real calendar day as AAAA-MM-JJ (month 01 to 12, day 01 to 31).
    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // A missing member makes getAfter fail, which refuses the write. One call per parent keeps
    // the rules under the limit of 10 document reads of a single write.
    function isAdultMember(memberId) {
      return memberId is string
        && getAfter(memberPath(memberId)).data.profile == 'adult';
    }

    // Responsible adults (lot 7 audit): an adult has none, since parentIds gives rights over the
    // events and answers of that member; a child has one to four, each an existing adult.
    function hasValidParents(m) {
      return m.parentIds is list
        && m.parentIds.size() <= 4
        && ((m.profile == 'adult' && m.parentIds.size() == 0) || (m.profile != 'adult' && m.parentIds.size() > 0))
        && (m.parentIds.size() < 1 || isAdultMember(m.parentIds[0]))
        && (m.parentIds.size() < 2 || isAdultMember(m.parentIds[1]))
        && (m.parentIds.size() < 3 || isAdultMember(m.parentIds[2]))
        && (m.parentIds.size() < 4 || isAdultMember(m.parentIds[3]));
    }

    // A chef de famille chooses responsible adults in the child's household only.
    function isAdultOf(memberId, householdId) {
      return isAdultMember(memberId) && getAfter(memberPath(memberId)).data.householdId == householdId;
    }

    function parentsInHousehold(m) {
      return (m.parentIds.size() < 1 || isAdultOf(m.parentIds[0], m.householdId))
        && (m.parentIds.size() < 2 || isAdultOf(m.parentIds[1], m.householdId))
        && (m.parentIds.size() < 3 || isAdultOf(m.parentIds[2], m.householdId))
        && (m.parentIds.size() < 4 || isAdultOf(m.parentIds[3], m.householdId));
    }

    // Shape of a member document written by the admin principal or a chef de famille. Profiles
    // and parents follow docs/data-model.md.
    // colorIndex is optional: one of the 13 member colors of the app.
    function isValidMember(m) {
      return m.keys().hasAll(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid'])
        && m.keys().hasOnly(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid', 'colorIndex', 'phone'])
        && (!('colorIndex' in m) || (m.colorIndex is int && m.colorIndex >= 0 && m.colorIndex <= 12))
        // Coordonnées (récit 66): an optional phone, for an adult only, never for a child.
        && (!('phone' in m) || (isPhone(m.phone) && m.profile == 'adult'))
        && m.firstName is string && m.firstName.size() > 0 && m.firstName.size() <= 40
        && (m.email == null || (m.email is string && m.email == m.email.lower()))
        && (m.birthDate == null || isDay(m.birthDate))
        && m.householdId is string && exists(/databases/$(database)/documents/households/$(m.householdId))
        && m.profile in ['adult', 'childWithApp', 'childWithoutApp']
        && m.isAdmin is bool && (!m.isAdmin || m.profile == 'adult')
        && hasValidParents(m)
        // An adult or a child with the app may wait for their address: they cannot sign in until
        // it is added, and the email index only exists once it is.
        && (m.profile != 'childWithoutApp' || m.email == null);
    }

    // The email index and the member document must always agree, in the same batched write.
    function emailIndexMatches(memberId, email) {
      return email == null || getAfter(emailIndexPath(email)).data.memberId == memberId;
    }

    // --- Collections ----------------------------------------------------------------------------

    // memberEmails/{email} -> { memberId }. Written by whoever manages the member's household,
    // always in the same batch as
    // the member document it points to. Anyone signed in may read the entry for their own address,
    // so the app can tell "not in the family" apart from a permission error.
    match /memberEmails/{email} {
      allow read: if hasVerifiedEmail() && (email == myEmail() || isMember());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['memberId'])
        && getAfter(memberPath(request.resource.data.memberId)).data.email == email
        && managesHousehold(getAfter(memberPath(request.resource.data.memberId)).data.householdId);
      // Removing a member or changing their address must drop the old entry, otherwise the
      // person would keep access.
      allow delete: if isMember()
        && (!existsAfter(memberPath(resource.data.memberId))
            || getAfter(memberPath(resource.data.memberId)).data.email != email)
        && (isOwner()
            || (exists(memberPath(resource.data.memberId))
                && isChefOf(get(memberPath(resource.data.memberId)).data.householdId)));
      allow update: if false;
    }

    // members/{memberId}. Readable by the whole family.
    match /members/{memberId} {
      allow read: if isMember();

      // First sign-in: a member links their own Firebase UID, once, and nothing else.
      allow update: if isMember()
        && myMemberId() == memberId
        && resource.data.get('uid', null) == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);

      // Coordonnées (récit 66): an adult sets or removes their own phone, and nothing else.
      allow update: if isMember()
        && myMemberId() == memberId
        && resource.data.profile == 'adult'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone'])
        && (!('phone' in request.resource.data) || isPhone(request.resource.data.phone));

      // Only the admin principal adds a member (the family rarely grows, so the chefs have no
      // button for it). No linked account yet.
      allow create: if isOwner()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == null
        && emailIndexMatches(memberId, request.resource.data.email);

      // The admin principal edits anyone and names the chefs. A chef de famille edits the members
      // of their household, never the chef flag, never the admin principal, and keeps the member
      // in that household. Nobody changes the linked account.
      allow update: if isMember()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        // A member who already signed in keeps an address: removing it would lock them out.
        && (resource.data.uid == null || request.resource.data.email != null)
        && emailIndexMatches(memberId, request.resource.data.email)
        && (resource.data.email == null || resource.data.email == request.resource.data.email
            || !existsAfter(emailIndexPath(resource.data.email)))
        && (isOwner()
            || (isChefOf(resource.data.householdId)
                && request.resource.data.householdId == resource.data.householdId
                && request.resource.data.isAdmin == resource.data.isAdmin
                && memberId != ownerId()
                // Changing another chef's address would hand their access to someone else.
                && (resource.data.isAdmin == false
                    || memberId == myMemberId()
                    || request.resource.data.email == resource.data.email)
                && (request.resource.data.parentIds == resource.data.parentIds
                    || parentsInHousehold(request.resource.data))));

      // The admin principal or a chef of the household removes a member (a separation, for
      // example), never themselves; a chef never removes another chef or the admin principal.
      // The email entry goes in the same batch.
      allow delete: if isMember()
        && memberId != myMemberId()
        && (resource.data.email == null || !existsAfter(emailIndexPath(resource.data.email)))
        && (isOwner()
            || (isChefOf(resource.data.householdId)
                && resource.data.isAdmin == false
                && memberId != ownerId()));
    }

    function isValidHousehold(h) {
      return h.keys().hasOnly(['name', 'address'])
        && h.name is string
        && h.name.size() > 0 && h.name.size() <= 40
        // Coordonnées (récit 66): an optional address for the household, set by who manages it.
        && (!('address' in h) || (h.address is string && h.address.size() > 0 && h.address.size() <= 200));
    }

    // A phone number as people type it: digits, spaces, dots, dashes, brackets and a leading +.
    function isPhone(value) {
      return value is string && value.matches('^[+]?[0-9 .()-]{6,24}$');
    }

    // households/{householdId}. Readable by the whole family. The admin principal creates and
    // deletes them (the app only offers to delete an empty one); a chef renames their own.
    match /households/{householdId} {
      allow read: if isMember();
      allow create: if isOwner() && isValidHousehold(request.resource.data);
      allow update: if managesHousehold(householdId) && isValidHousehold(request.resource.data);
      allow delete: if isOwner();
    }

    // --- Events (lot 4) ---------------------------------------------------------------------------

    function me() {
      return get(memberPath(myMemberId())).data;
    }

    // True when the caller is one of the responsible adults of the member [memberId] (a child).
    function isParentOf(memberId) {
      return memberId is string
        && exists(memberPath(memberId))
        && myMemberId() in get(memberPath(memberId)).data.parentIds;
    }

    // Shape of an event. Who it is for is stored on the event itself, so the rules never have to
    // read other events. authorName keeps the events of a removed member readable.
    // [extra]: the optional keys besides coverPhoto; an occurrence of a series (récit 54) has 4 more,
    // written by the server only, so an event created from the app never has them.
    function isValidEvent(e, extra) {
      return e.keys().hasAll(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                              'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                             'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt', 'coverPhoto',
                             'placeKind', 'placeHouseholdId', 'mentionIds'].concat(extra))
        && isDay(e.date)
        && e.updatedAt == request.time
        && isValidEventContent(e);
    }

    // What an event and a series of events (récit 54) share: the texts, the time and the target.
    function isValidEventContent(e) {
      return e.title is string && e.title.size() > 0 && e.title.size() <= 80
        && (e.time == null || (e.time is string && e.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (e.place == null || (e.place is string && e.place.size() <= 120))
        && isValidPlace(e)
        && (e.note == null || (e.note is string && e.note.size() <= 1000))
        && hasCommentMentions(e)
        && e.authorName is string && e.authorName.size() > 0 && e.authorName.size() <= 40
        && ((e.targetType == 'self' && e.targetMemberId == e.authorId && e.householdId == null)
            || (e.targetType == 'child' && e.targetMemberId is string && e.householdId == null
                && exists(memberPath(e.targetMemberId))
                && get(memberPath(e.targetMemberId)).data.profile != 'adult')
            || (e.targetType == 'household' && e.targetMemberId == null && e.householdId is string
                && exists(/databases/$(database)/documents/households/$(e.householdId)))
            || (e.targetType == 'family' && e.targetMemberId == null && e.householdId == null));
    }

    // Where it takes place (récit 74). place stays the text every screen shows; placeKind says what it
    // is: left out or null for « Autre » (the events of before), 'address' for an address, 'household'
    // for « Chez un foyer », with the household in placeHouseholdId (its name in place).
    function isValidPlace(e) {
      let kind = e.get('placeKind', null);
      let householdId = e.get('placeHouseholdId', null);
      return (kind == null && householdId == null)
        || (kind == 'address' && householdId == null && e.place is string && e.place.size() > 0)
        || (kind == 'household' && householdId is string && e.place is string && e.place.size() > 0
            && exists(/databases/$(database)/documents/households/$(householdId)));
    }

    // Plus de photos (PRD, récit 44): coverPhoto, optional, names the cover sent to Storage beforehand,
    // events/{eventId}/cover/{memberId}/{photoId} (storage.rules). Whoever may change the event adds,
    // changes or removes it (null or left out), but only names a photo of their own folder.
    function isValidCover(eventId, e, before) {
      return !('coverPhoto' in e) || e.coverPhoto == null
        || (before != null && 'coverPhoto' in before && e.coverPhoto == before.coverPhoto)
        || (e.coverPhoto is string
            && e.coverPhoto.matches('^events/' + eventId + '/cover/[A-Za-z0-9]{1,40}/[A-Za-z0-9]{1,40}$')
            && e.coverPhoto.split('/')[3] == myMemberId());
    }

    // PRD "Droits par profil", creation: the admin principal for anyone; an adult (chefs included)
    // for themselves, one of their children, their household or the whole family; a child with the
    // app for themselves only.
    function canTarget(e) {
      return isOwner()
        || e.targetType == 'self'
        || (me().profile == 'adult'
            && (e.targetType == 'family'
                || (e.targetType == 'household' && e.householdId == me().householdId)
                || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // PRD "Droits par profil" and récit 5, edit and delete: the admin principal all events; anyone
    // their own; a chef de famille those written by a member of their household; an adult also the
    // events of their children (written by them or for them).
    function canManage(e) {
      return isOwner()
        || e.authorId == myMemberId()
        || (exists(memberPath(e.authorId)) && isChefOf(get(memberPath(e.authorId)).data.householdId))
        || (me().profile == 'adult'
            && (isParentOf(e.authorId) || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // events/{eventId}. The whole family sees the planning.
    match /events/{eventId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidEvent(request.resource.data, [])
        && isValidCover(eventId, request.resource.data, null)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && canTarget(request.resource.data);

      // The author and creation time never change; a new target must be one the editor may choose.
      allow update: if isMember()
        && canManage(resource.data)
        && isValidEvent(request.resource.data, ['seriesId', 'occurrence', 'detached', 'bySeries'])
        && isValidCover(eventId, request.resource.data, resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && seriesFieldsKept(request.resource.data, resource.data)
        && (canTarget(request.resource.data)
            || (request.resource.data.targetType == resource.data.targetType
                && request.resource.data.targetMemberId == resource.data.targetMemberId
                && request.resource.data.householdId == resource.data.householdId));

      allow delete: if isMember() && canManage(resource.data);
    }

    // « Cette fois seulement » (récit 54): an occurrence keeps its series, its day of origin and the
    // server's mark; changing it by hand marks it detached, so the series no longer rewrites it.
    function seriesFieldsKept(after, before) {
      return (!('seriesId' in before) && !after.keys().hasAny(['seriesId', 'occurrence', 'detached', 'bySeries']))
        || ('seriesId' in before
            && after.get('seriesId', null) == before.seriesId
            && after.get('occurrence', null) == before.get('occurrence', null)
            && after.get('bySeries', null) == before.get('bySeries', null)
            && after.get('detached', false) == true);
    }

    // --- Événements qui reviennent (PRD, récit 54) --------------------------------------------------
    //
    // eventSeries/{seriesId}: what repeats (the texts, the time and the target of an event) and how.
    // The server writes the occurrences as ordinary events, events/{seriesId}_{AAAAMMJJ}, for the
    // 12 months to come; each has its own answers, « Qui apporte quoi », cars and comments.
    // [rule]: freq weekly (every 1 or 2 weeks), monthly (same date, or same weekday: the 1st Sunday)
    // or yearly, from [start], until a day or for [count] times, or never. [exdates]: the days taken
    // out one by one (« Cette fois seulement » deleted). [applyFrom]: « celle-ci et les suivantes »,
    // the first day the texts apply to.

    function isValidRule(r) {
      return r is map
        && r.keys().hasAll(['freq', 'interval', 'monthlyBy', 'start', 'until', 'count'])
        && r.keys().hasOnly(['freq', 'interval', 'monthlyBy', 'start', 'until', 'count'])
        && r.freq in ['weekly', 'monthly', 'yearly']
        && (r.interval == 1 || (r.interval == 2 && r.freq == 'weekly'))
        && ((r.freq == 'monthly' && r.monthlyBy in ['date', 'weekday']) || (r.freq != 'monthly' && r.monthlyBy == null))
        && isDay(r.start)
        && (r.until == null || (isDay(r.until) && r.until >= r.start))
        && (r.count == null || (r.count is int && r.count >= 2 && r.count <= 200))
        && (r.until == null || r.count == null);
    }

    function isValidSeries(e) {
      return e.keys().hasAll(['title', 'time', 'place', 'note', 'targetType', 'targetMemberId', 'householdId',
                              'authorId', 'authorName', 'rule', 'exdates', 'applyFrom', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['title', 'time', 'place', 'note', 'targetType', 'targetMemberId', 'householdId',
                             'authorId', 'authorName', 'rule', 'exdates', 'applyFrom', 'createdAt', 'updatedAt',
                             'placeKind', 'placeHouseholdId', 'mentionIds'])
        && isValidRule(e.rule)
        && e.exdates is list && e.exdates.size() <= 100
        && (e.applyFrom == null || isDay(e.applyFrom))
        && e.updatedAt == request.time
        && isValidEventContent(e);
    }

    match /eventSeries/{seriesId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidSeries(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && request.resource.data.exdates.size() == 0
        && canTarget(request.resource.data);

      // Same rights as an event of the series: its author, the admin principal, a chef, a parent.
      allow update: if isMember()
        && canManage(resource.data)
        && isValidSeries(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && (canTarget(request.resource.data)
            || (request.resource.data.targetType == resource.data.targetType
                && request.resource.data.targetMemberId == resource.data.targetMemberId
                && request.resource.data.householdId == resource.data.householdId));

      allow delete: if isMember() && canManage(resource.data);
    }

    // --- Who is coming (lot 6) --------------------------------------------------------------------

    // PRD, récit 4: each member answers for themselves, and each adult also for their children.
    function canAnswerFor(memberId) {
      return memberId == myMemberId() || (me().profile == 'adult' && isParentOf(memberId));
    }

    function isValidRsvp(r) {
      return r.keys().hasAll(['status', 'answeredBy', 'updatedAt'])
        && r.keys().hasOnly(['status', 'answeredBy', 'updatedAt'])
        && r.status in ['yes', 'maybe', 'no']
        && r.answeredBy == myMemberId()
        && r.updatedAt == request.time;
    }

    // events/{eventId}/rsvps/{memberId}: one answer per member, written by that member or one of
    // their responsible adults. When an event is deleted, its answers are cleaned up on the server
    // (lot 8), which also warns the members who said they were coming.
    match /events/{eventId}/rsvps/{memberId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && exists(memberPath(memberId))
        && canAnswerFor(memberId)
        && isValidRsvp(request.resource.data);
      allow delete: if isMember() && canAnswerFor(memberId);
    }

    // --- Qui apporte quoi (PRD, récit 4 bis) -------------------------------------------------------
    //
    // events/{eventId}/bring/{itemId}: one thing to bring (entrée, pain…). Every member with the app
    // adds a line or takes one; a line taken shows the first name of whoever took it, who can let it
    // go. The label never changes: a wrong line is deleted by its author or by those who manage the event.

    function eventPath(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }

    function isBringTaker(b) {
      return (b.takerId == null && b.takerName == null)
        || (b.takerId == myMemberId() && b.takerName == me().firstName);
    }

    // recipeId (optional): a recipe of the book joined when the line is added. It never changes after,
    // since an update touches only the taker fields.
    function isValidBring(b) {
      return b.keys().hasAll(['label', 'authorId', 'takerId', 'takerName', 'createdAt', 'updatedAt'])
        && b.keys().hasOnly(['label', 'authorId', 'takerId', 'takerName', 'createdAt', 'updatedAt', 'recipeId'])
        && b.label is string && b.label.trim().size() > 0 && b.label.size() <= 60
        && (!('recipeId' in b) || (b.recipeId is string && b.recipeId.size() > 0 && b.recipeId.size() <= 64))
        && b.updatedAt == request.time;
    }

    match /events/{eventId}/bring/{itemId} {
      allow read: if isMember();

      allow create: if isMember()
        && exists(eventPath(eventId))
        && isValidBring(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.createdAt == request.time
        && isBringTaker(request.resource.data);

      // Take a free line, or let go of one: the taker, the line's author or those who manage the event.
      allow update: if isMember()
        && isValidBring(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['takerId', 'takerName', 'updatedAt'])
        && ((resource.data.takerId == null
             && request.resource.data.takerId == myMemberId()
             && request.resource.data.takerName == me().firstName)
            || (resource.data.takerId != null
                && request.resource.data.takerId == null && request.resource.data.takerName == null
                && (resource.data.takerId == myMemberId()
                    || resource.data.authorId == myMemberId()
                    || canManage(get(eventPath(eventId)).data))));

      allow delete: if isMember()
        && (resource.data.authorId == myMemberId() || canManage(get(eventPath(eventId)).data));
    }

    // --- On y va ensemble (PRD, récit 52) ----------------------------------------------------------
    //
    // events/{eventId}/rides/{driverId}: the car of an adult who comes, with its seats, a town and a
    // time to leave (both optional, never a position). [passengers] holds member ids: each member
    // gets in or out for themselves or a child they answer for, one at a time, never beyond the seats.
    // The driver changes the rest and lets anyone out. « Je ne viens plus » clears it on the server.

    function isValidRide(r) {
      return r.keys().hasAll(['seats', 'from', 'leaveAt', 'passengers', 'createdAt', 'updatedAt'])
        && r.keys().hasOnly(['seats', 'from', 'leaveAt', 'passengers', 'createdAt', 'updatedAt'])
        && r.seats is int && r.seats >= 1 && r.seats <= 8
        && (r.from == null || (r.from is string && r.from.trim().size() > 0 && r.from.size() <= 40))
        && (r.leaveAt == null || (r.leaveAt is string && r.leaveAt.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && r.passengers is list && r.passengers.size() <= r.seats
        && r.passengers.toSet().size() == r.passengers.size()
        && r.updatedAt == request.time;
    }

    // Who got in: one member at most, a member of the family, never the driver, answered for by me.
    function rideAddedOk(driverId, added) {
      return added.size() == 0
        || (added.size() == 1 && added[0] is string && added[0] != driverId
            && exists(memberPath(added[0])) && canAnswerFor(added[0]));
    }

    match /events/{eventId}/rides/{driverId} {
      allow read: if isMember();

      allow create: if isMember()
        && driverId == myMemberId()
        && me().profile == 'adult'
        && exists(eventPath(eventId))
        && saidComing(eventId)
        && isValidRide(request.resource.data)
        && request.resource.data.passengers.size() == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && isValidRide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // The driver: seats, town, time, and lets anyone out (or takes a child of theirs in).
          (driverId == myMemberId()
            && rideAddedOk(driverId, request.resource.data.passengers.removeAll(resource.data.passengers)))
          // Anyone else: one member in or out, themselves or a child they answer for.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['passengers', 'updatedAt'])
            && (request.resource.data.passengers.removeAll(resource.data.passengers).size()
                + resource.data.passengers.removeAll(request.resource.data.passengers).size()) == 1
            && rideAddedOk(driverId, request.resource.data.passengers.removeAll(resource.data.passengers))
            && (resource.data.passengers.removeAll(request.resource.data.passengers).size() == 0
                || canAnswerFor(resource.data.passengers.removeAll(request.resource.data.passengers)[0])))
        );

      allow delete: if isMember() && (driverId == myMemberId() || canManage(get(eventPath(eventId)).data));
    }

    // events/{eventId}/rideNeeds/{memberId}: « J'ai besoin d'une place », without a driver yet.
    match /events/{eventId}/rideNeeds/{memberId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && exists(eventPath(eventId))
        && exists(memberPath(memberId))
        && canAnswerFor(memberId)
        && request.resource.data.keys().hasOnly(['askedBy', 'updatedAt'])
        && request.resource.data.askedBy == myMemberId()
        && request.resource.data.updatedAt == request.time;
      allow delete: if isMember() && (canAnswerFor(memberId) || canManage(get(eventPath(eventId)).data));
    }

    // The album of an event (récit 41) opens on its day: from 22:00 UTC the day before,
    // midnight in France in summer, 23:00 in winter (an hour before the app, harmless).
    // Its photos have the shape of the trip photos (isValidAlbumPhoto in the trips section): 30 places per person, files in Storage at events/{eventId}/{authorId}/.
    function albumIsOpen(eventId) {
      let day = get(/databases/$(database)/documents/events/$(eventId)).data.date.split('-');
      return request.time >= timestamp.date(int(day[0]), int(day[1]), int(day[2])) - duration.value(2, 'h');
    }

    function saidComing(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(myMemberId())).data.status == 'yes';
    }

    // events/{eventId}/photos/{photoId}. Everyone who sees the event sees its album; a member who
    // said « je viens » adds photos of their own from the day of the event. The author removes
    // them, as do the author of the event and the admin principal. Deleting the event deletes them.
    match /events/{eventId}/photos/{photoId} {
      allow read: if isMember();
      allow create: if isMember()
        && albumIsOpen(eventId)
        && saidComing(eventId)
        && isValidAlbumPhoto(request.resource.data, photoId);
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId()
            || isOwner()
            || get(/databases/$(database)/documents/events/$(eventId)).data.authorId == myMemberId());
    }

    // events/{eventId}/comments/{commentId} (PRD, récit 28). Whoever sees the event (every member)
    // reads its comments and writes their own: a text of 1 to 500 characters, kept 12 months
    // (expireAt, TTL), set by the phone between 360 and 370 days ahead. Its author changes only the
    // text. Its author removes it, as do the admin principal and a chef de famille of the author's
    // household. Deleting the event deletes them on the server (onEventDeleted).
    function isCommentText(text) {
      return text is string && text.size() > 0 && text.size() <= 500;
    }

    // The members named « @Prénom » in a comment or in the note of an event or a coup de main
    // (Kévin, 19/11): optional, at most 20, no duplicate. The server tells each of them once.
    function hasCommentMentions(data) {
      return !('mentionIds' in data) || isIdList(data.mentionIds, 0, 20);
    }

    match /events/{eventId}/comments/{commentId} {
      allow read: if isMember();
      allow create: if isMember()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt', 'expireAt', 'mentionIds'])
        && isCommentText(request.resource.data.text)
        && hasCommentMentions(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time + duration.value(360, 'd')
        && request.resource.data.expireAt < request.time + duration.value(370, 'd');
      allow update: if isMember()
        && resource.data.authorId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentionIds'])
        && isCommentText(request.resource.data.text)
        && hasCommentMentions(request.resource.data)
        && request.resource.data.editedAt == request.time;
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId()
            || isOwner()
            || (exists(memberPath(resource.data.authorId)) && isChefOf(get(memberPath(resource.data.authorId)).data.householdId)));
    }

    // « Ne plus être prévenu » for the comments of an event: events/{eventId}/commentMutes/{memberId},
    // written and removed by that member only. The server reads them before telling anyone.
    match /events/{eventId}/commentMutes/{memberId} {
      allow read: if isMember() && memberId == myMemberId();
      allow create: if isMember()
        && memberId == myMemberId()
        && request.resource.data.keys().hasOnly(['mutedAt'])
        && request.resource.data.mutedAt == request.time;
      allow delete: if isMember() && memberId == myMemberId();
    }

    // The answers of all events at once, for the counters of the planning (collectionGroup query).
    // Read only: writes go through events/{eventId}/rsvps/{memberId} above.
    match /{path=**}/rsvps/{memberId} {
      allow read: if isMember();
    }

    // --- Notifications (lot 8) --------------------------------------------------------------------

    // members/{memberId}/devices/{token}: the phones of a member, one document per notification
    // token. Only that member reads or writes them. The Cloud Functions read them with their own
    // server access, and delete the token of an uninstalled app.
    match /members/{memberId}/devices/{token} {
      allow read, delete: if isMember() && myMemberId() == memberId;
      allow create, update: if isMember()
        && myMemberId() == memberId
        && token.size() <= 4096
        && request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // members/{memberId}/settings/notifications: the member's own choices (PRD, récit 6 bis: the
    // reminder the evening before can be turned off; récit 32: the good news too; récit 37: the
    // question of the week; récit 6 quinquies: the level, the families, the quiet hours). Nobody
    // else reads or changes them, not even the responsible adults of a child.
    // quietQueue/{memberId}, the notices held for 8 h, has no rule: only the functions use it.
    // Souvenirs (PRD, récit 34): members/{memberId}/souvenirs/{key}, given by the server only. A
    // souvenir is private (carte EXPERT-3): its member reads it, and the family reads it once the
    // member shows it (`shown`), the only field the member changes. souvenirCounters/{memberId}
    // holds the counted gestures, read by its member only for « Encore 5 coups de main ».
    // souvenirMarks stays closed: only the Cloud Functions use it.
    match /members/{memberId}/souvenirs/{key} {
      allow read: if isMember() && (memberId == myMemberId() || resource.data.shown == true);
      allow update: if isMember()
        && memberId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shown'])
        && request.resource.data.shown is bool;
      allow create, delete: if false;
    }

    match /souvenirCounters/{memberId} {
      allow read: if isMember() && memberId == myMemberId();
      allow write: if false;
    }

    // members/{memberId}/reminders/{id} (PRD rév. 248, récit 56): « Me le rappeler » on an event
    // (id = the event's id) or on every occurrence of a series (id = series-{seriesId}). Private:
    // only the member reads or writes them, not even the admin principal in « Voir comme ». The
    // functions send them; remindersSent stays closed.
    function isReminderOffsets(offsets) {
      return offsets is list && offsets.size() <= 5 && offsets.toSet().hasOnly(['h1', 'h3', 'morning', 'd2', 'w1']);
    }

    match /members/{memberId}/reminders/{reminderId} {
      allow read, delete: if isMember() && myMemberId() == memberId;
      allow create, update: if isMember()
        && myMemberId() == memberId
        && isReminderOffsets(request.resource.data.offsets)
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.keys().hasOnly(['eventId', 'offsets', 'updatedAt'])
              && request.resource.data.eventId == reminderId)
          || (request.resource.data.keys().hasOnly(['seriesId', 'offsets', 'updatedAt'])
              && request.resource.data.seriesId is string
              && reminderId == 'series-' + request.resource.data.seriesId));
    }

    match /members/{memberId}/settings/{settingId} {
      allow read: if isMember() && myMemberId() == memberId;
      allow create, update: if isMember()
        && myMemberId() == memberId
        && ((settingId == 'packing' && isValidPackingTemplate(request.resource.data))
            || (settingId == 'notifications' && isValidNotificationSettings(request.resource.data)));
    }

    // « Ma valise » (récit 62): the list each one starts a bag from, changed as they like.
    function isValidPackingTemplate(t) {
      return t.keys().hasOnly(['labels', 'updatedAt'])
        && t.labels is list && t.labels.size() <= 80
        && t.updatedAt == request.time;
    }

    function isValidNotificationSettings(n) {
      return n.keys().hasOnly(['dayBeforeReminder', 'goodNews', 'weekly', 'souvenirs', 'tree', 'recap', 'birthdayWishes',
          'planning', 'reminders', 'gifts', 'comments', 'helpRequests', 'trips', 'quietHours', 'defaultReminders', 'packingReminder',
          'eveningReactions', 'eveningComments', 'eveningWeekly', 'eveningSouvenirs'])
        // Récit 70: `false` keeps a kind of small news immediate when the résumé du soir is on.
        && (!('eveningReactions' in n) || n.eveningReactions is bool)
        && (!('eveningComments' in n) || n.eveningComments is bool)
        && (!('eveningWeekly' in n) || n.eveningWeekly is bool)
        && (!('eveningSouvenirs' in n) || n.eveningSouvenirs is bool)
        // Récit 62: `false` turns off the reminder of the day before a trip, for the bag.
        && (!('packingReminder' in n) || n.packingReminder is bool)
        // Récit 56: the reminders given to the events I say « Je viens » to.
        && (!('defaultReminders' in n) || isReminderOffsets(n.defaultReminders))
        // Récit 6 quinquies: one switch per family (the three levels set them at once), the quiet hours.
        && (!('planning' in n) || n.planning is bool)
        && (!('reminders' in n) || n.reminders is bool)
        && (!('gifts' in n) || n.gifts is bool)
        && (!('comments' in n) || n.comments is bool)
        && (!('helpRequests' in n) || n.helpRequests is bool)
        && (!('trips' in n) || n.trips is bool)
        && (!('quietHours' in n) || n.quietHours is bool)
        && (!('dayBeforeReminder' in n) || n.dayBeforeReminder is bool)
        && (!('goodNews' in n) || n.goodNews is bool)
        && (!('weekly' in n) || n.weekly is bool)
        && (!('souvenirs' in n) || n.souvenirs is bool)
        && (!('tree' in n) || n.tree is bool)
        && (!('recap' in n) || n.recap is bool)
        && (!('birthdayWishes' in n) || n.birthdayWishes is bool);
    }

    // L'arbre de la famille et le défi du mois (PRD, récit 35): familyTree/current and
    // challenges/{AAAA-MM}, written by the Cloud Functions only, read by the whole family. They
    // hold no name: nobody sees who gave the most (carte EXPERT-3). treeMarks and treeDays stay
    // closed: only the functions use them, for the cap of 5 leaves a day.
    match /familyTree/{treeId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /challenges/{month} {
      allow read: if isMember();
      allow write: if false;
    }

    // --- Le défi lancé par un foyer (PRD, récit 35 bis) --------------------------------------

    function isMonthId(m) {
      return m is string && m.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$');
    }

    function monthIndex(m) {
      return int(m.split('-')[0]) * 12 + int(m.split('-')[1]) - 1;
    }

    // challengeRotation/current: the order in which the foyers launch the challenge, a month each
    // from startMonth. The admin principal sets it in Administration; the family reads it.
    match /challengeRotation/{rotationId} {
      allow read: if isMember();
      allow write: if isOwner() && rotationId == 'current'
        && request.resource.data.keys().hasOnly(['householdIds', 'startMonth', 'updatedAt'])
        && request.resource.data.householdIds is list
        && request.resource.data.householdIds.size() >= 1 && request.resource.data.householdIds.size() <= 20
        && isMonthId(request.resource.data.startMonth)
        && request.resource.data.updatedAt == request.time;
    }

    // The foyer whose turn [month] is.
    function hostOf(month) {
      let r = get(/databases/$(database)/documents/challengeRotation/current).data;
      return r.householdIds[(monthIndex(month) - monthIndex(r.startMonth)) % r.householdIds.size()];
    }

    // The month in progress or the next one (in UTC: a few hours apart from Paris at the turn of a month).
    function isNowOrNext(month) {
      let now = request.time.year() * 12 + request.time.month() - 1;
      return monthIndex(month) == now || monthIndex(month) == now + 1;
    }

    function isValidHostedChallenge(c, month) {
      return c.keys().hasOnly(['householdId', 'status', 'kind', 'title', 'emoji', 'illustration', 'target', 'note', 'updatedBy', 'updatedAt'])
        && c.householdId == me().householdId
        && c.householdId == hostOf(month)
        && c.status in ['draft', 'published', 'skipped']
        && c.kind in ['photo', 'outing', 'cooking', 'kindness', 'creative']
        && c.title is string && c.title.trim().size() > 0 && c.title.size() <= 60
        && c.emoji is string && c.emoji.size() > 0 && c.emoji.size() <= 8
        && c.illustration in ['sun', 'heart', 'leaf', 'star', 'camera', 'pot']
        && c.target is int && c.target >= 3 && c.target <= 50
        // The optional word of the foyer for « Comment ça marche » (récit 65).
        && (!('note' in c) || (c.note is string && c.note.size() <= 140))
        && c.updatedBy == myMemberId()
        && c.updatedAt == request.time;
    }

    // householdChallenges/{AAAA-MM}: the challenge a foyer prepares for its month. Every member of
    // the foyer prepares it, children included; only an adult publishes it or passes the turn. Once
    // published or passed it no longer changes from the app: the admin principal replaces it with
    // challengePicks. The functions turn it into challenges/{month}.
    match /householdChallenges/{month} {
      allow read: if isMember();
      allow create, update: if isMember() && isMonthId(month) && isNowOrNext(month)
        && month >= get(/databases/$(database)/documents/challengeRotation/current).data.startMonth
        && (resource == null || resource.data.status == 'draft')
        && isValidHostedChallenge(request.resource.data, month)
        && (request.resource.data.status == 'draft' || me().profile == 'adult');
      allow delete: if false;
    }

    // challengePicks/{AAAA-MM}: the challenge the admin principal chose in Administration, from
    // the list of the functions (tree.ts, CATALOG). The functions apply it to challenges/{month}.
    match /challengePicks/{month} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && month.matches('^20[0-9]{2}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['choiceId', 'pickedAt'])
        && request.resource.data.choiceId in ['goodNewsStart', 'winterPhotos', 'springSigns', 'springNews',
          'outdoorPhotos', 'summerNews', 'holidayPhotos', 'postcards', 'backToSchool', 'autumnColours',
          'littleJoys', 'christmasPhotos', 'kitchen', 'pets', 'proudOf', 'together']
        && request.resource.data.pickedAt == request.time;
      allow delete: if false;
    }

    // --- Coups de main (PRD, récits 13 à 18) ---------------------------------------------------------

    // A day AAAA-MM-JJ as a timestamp at midnight UTC.
    function helpDay(d) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
    }

    // Not in the past. One day of slack covers the gap between Paris and UTC.
    function isHelpDayAhead(d) {
      return helpDay(d) > request.time - duration.value(1, 'd');
    }

    function isHelpTime(t) {
      return t == null || (t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    // Who the request is for: the author, or one of their children for an adult. The admin
    // principal asks for anyone.
    function canAskFor(memberId) {
      return memberId == myMemberId()
        || isOwner()
        || (me().profile == 'adult' && isParentOf(memberId));
    }

    // Only the author, the people warned and the responsible adults of a helped child see a
    // request (carte PRODUIT-8). viewerIds is the author followed by notifyIds, so the app can
    // query it with array-contains. The responsible adults of a child are always in notifyIds (récit 14), except
    // the author.
    function hasValidAudience(r) {
      return r.notifyIds is list
        && r.notifyIds.size() > 0 && r.notifyIds.size() <= 30
        && !(r.authorId in r.notifyIds)
        && r.viewerIds == [r.authorId].concat(r.notifyIds)
        && (get(memberPath(r.forMemberId)).data.profile == 'adult'
            || r.viewerIds.hasAll(get(memberPath(r.forMemberId)).data.parentIds));
    }

    // The volunteer's short word (récit 16, spec rév. 8): optional, 200 characters at most.
    function isVolunteerNote(v) {
      return v == null || (v is string && v.size() <= 200);
    }

    // The 19 fields, plus volunteerNote, photo and unavailableIds when there are some (older
    // requests have 19).
    function isValidHelpRequest(r) {
      return r.keys().hasAll(['kind', 'title', 'date', 'startTime', 'endTime', 'place', 'note', 'authorId',
                              'authorName', 'forMemberId', 'notifyIds', 'viewerIds', 'status', 'volunteerId',
                              'volunteerName', 'declinedBy', 'thankedAt', 'createdAt', 'updatedAt'])
        && r.keys().hasOnly(['kind', 'title', 'date', 'startTime', 'endTime', 'place', 'note', 'authorId',
                             'authorName', 'forMemberId', 'notifyIds', 'viewerIds', 'status', 'volunteerId',
                             'volunteerName', 'declinedBy', 'thankedAt', 'createdAt', 'updatedAt',
                             'volunteerNote', 'photo', 'unavailableIds', 'mentionIds', 'placeKind', 'placeHouseholdId'])
        && isVolunteerNote(r.get('volunteerNote', null))
        && r.get('unavailableIds', []) is list && r.get('unavailableIds', []).size() <= 20
        && r.kind in ['childcare', 'ride', 'other']
        && r.title is string && r.title.size() > 0 && r.title.size() <= 80
        && isDay(r.date)
        && isHelpTime(r.startTime) && isHelpTime(r.endTime)
        && (r.startTime == null || r.endTime == null || r.startTime < r.endTime)
        && (r.place == null || (r.place is string && r.place.size() <= 120))
        // « Où » like the events (récit 74, Kévin 20/11): autre, une adresse, or chez un foyer.
        && isValidPlace(r)
        && (r.note == null || (r.note is string && r.note.size() <= 1000))
        // « @Prénom » in the note names only people who are warned (Kévin, 19/11).
        && hasCommentMentions(r) && r.notifyIds.hasAll(r.get('mentionIds', []))
        && r.authorName is string && r.authorName.size() > 0 && r.authorName.size() <= 40
        && r.forMemberId is string && exists(memberPath(r.forMemberId))
        && r.status in ['open', 'taken', 'cancelled']
        && (r.declinedBy == null || r.declinedBy is string)
        && r.updatedAt == request.time
        && hasValidAudience(r);
    }

    // The image of a request (Kévin 16/11, a QR code): optional, the base of a photo sent beforehand
    // to helpRequests/{requestId}/{memberId}/{photoId} (storage.rules). Whoever writes the request
    // adds, changes or removes it, but only names a photo of their own folder.
    function isValidHelpPhoto(requestId, r, before) {
      return r.get('photo', null) == null
        || (before != null && r.photo == before.get('photo', null))
        || (r.photo is string
            && r.photo.matches('^helpRequests/' + requestId + '/[A-Za-z0-9]{1,40}/[A-Za-z0-9]{1,40}$')
            && r.photo.split('/')[2] == myMemberId());
    }

    // Modify or cancel (Règles et droits): the admin principal all requests, anyone their own, an
    // adult those for or by their children.
    function canManageHelp(r) {
      return isOwner()
        || r.authorId == myMemberId()
        || (me().profile == 'adult' && (isParentOf(r.authorId) || isParentOf(r.forMemberId)));
    }

    function helpChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields.concat(['updatedAt']))
        && request.resource.data.updatedAt == request.time;
    }

    // « Je m'en occupe »: an adult who was warned takes an open request, never their own. The app
    // writes it in a transaction, so of two volunteers at once only the first one wins.
    function isHelpTake() {
      return resource.data.status == 'open'
        && request.resource.data.status == 'taken'
        && helpChanges(['status', 'volunteerId', 'volunteerName', 'volunteerNote'])
        && request.resource.data.volunteerId == myMemberId()
        && myMemberId() in resource.data.notifyIds
        && me().profile == 'adult'
        && request.resource.data.volunteerName == me().firstName
        && isVolunteerNote(request.resource.data.get('volunteerNote', null));
    }

    // The volunteer withdraws: the request is open again.
    function isHelpWithdraw() {
      return resource.data.status == 'taken'
        && request.resource.data.status == 'open'
        && helpChanges(['status', 'volunteerId', 'volunteerName', 'volunteerNote'])
        && resource.data.volunteerId == myMemberId()
        && request.resource.data.volunteerId == null
        && request.resource.data.volunteerName == null
        && request.resource.data.get('volunteerNote', null) == null;
    }

    // The volunteer writes, changes or clears their word later, and nothing else.
    function isHelpNote() {
      return resource.data.status == 'taken'
        && resource.data.volunteerId == myMemberId()
        && helpChanges(['volunteerNote'])
        && isVolunteerNote(request.resource.data.get('volunteerNote', null));
    }

    // « Je ne peux pas » (carte PRODUIT-22): only when the request was sent to one person.
    function isHelpDecline() {
      return resource.data.status == 'open'
        && resource.data.declinedBy == null
        && resource.data.notifyIds.size() == 1
        && helpChanges(['declinedBy'])
        && resource.data.notifyIds[0] == myMemberId()
        && request.resource.data.declinedBy == myMemberId();
    }

    // « Pas dispo » (présentation R1 bis) when others were warned too: someone warned adds their
    // own id, once, and the request stays open for the others. Nobody is told.
    function isHelpUnavailable() {
      let before = resource.data.get('unavailableIds', []);
      let after = request.resource.data.get('unavailableIds', []);
      return resource.data.status == 'open'
        && resource.data.notifyIds.size() > 1
        && helpChanges(['unavailableIds'])
        && myMemberId() in resource.data.notifyIds
        && !(myMemberId() in before)
        && after is list
        && after.size() == before.size() + 1
        && after.toSet() == before.toSet().union([myMemberId()].toSet());
    }

    // « Merci », once, by whoever manages a request that was taken.
    function isHelpThanks() {
      return resource.data.status == 'taken'
        && resource.data.thankedAt == null
        && helpChanges(['thankedAt'])
        && request.resource.data.thankedAt == request.time
        && canManageHelp(resource.data);
    }

    // Modify, widen to other people or cancel. The author, the person helped, the volunteer and
    // the creation time never change; the volunteer stays among the people warned; a new date is
    // not in the past; widening clears a « Je ne peux pas », and may clear the « Pas dispo ». A
    // cancelled request stays cancelled.
    function isHelpEdit(requestId) {
      return resource.data.status != 'cancelled'
        && request.resource.data.status in [resource.data.status, 'cancelled']
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['authorId', 'authorName', 'forMemberId', 'volunteerId', 'volunteerName', 'volunteerNote', 'thankedAt', 'createdAt'])
        && request.resource.data.declinedBy in [resource.data.declinedBy, null]
        && request.resource.data.get('unavailableIds', []) in [resource.data.get('unavailableIds', []), []]
        && (resource.data.volunteerId == null || resource.data.volunteerId in request.resource.data.notifyIds)
        && (request.resource.data.date == resource.data.date || isHelpDayAhead(request.resource.data.date))
        && canManageHelp(resource.data)
        && isValidHelpRequest(request.resource.data)
        && isValidHelpPhoto(requestId, request.resource.data, resource.data);
    }

    // helpRequests/{requestId}. One update rule; each case starts with the cheap checks that tell
    // the cases apart, which keeps a write far from the limit of 1000 expressions per request.
    match /helpRequests/{requestId} {
      // The admin principal reads them all (backup, and « Modifier : toutes »); the tab only lists
      // the requests where one is in viewerIds.
      allow read: if isMember() && (myMemberId() in resource.data.viewerIds || isOwner());

      allow create: if isMember()
        && isValidHelpRequest(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && canAskFor(request.resource.data.forMemberId)
        && isHelpDayAhead(request.resource.data.date)
        && request.resource.data.status == 'open'
        && request.resource.data.volunteerId == null
        && request.resource.data.volunteerName == null
        && request.resource.data.declinedBy == null
        && request.resource.data.get('unavailableIds', []).size() == 0
        && request.resource.data.thankedAt == null
        && request.resource.data.get('volunteerNote', null) == null
        && isValidHelpPhoto(requestId, request.resource.data, null)
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && (isHelpTake() || isHelpWithdraw() || isHelpNote() || isHelpDecline() || isHelpUnavailable() || isHelpThanks() || isHelpEdit(requestId));

      allow delete: if isMember() && canManageHelp(resource.data);
    }

    // --- Bonnes nouvelles (PRD, récit 32) ----------------------------------------------------------
    //
    // goodNews/{postId}: a short text, one to three photos in Storage (goodNews/{authorId}/{postId}/,
    // see storage.rules) and the members named. The whole family sees them (récit 32); when the
    // circles (PRD rév. 124) arrive, the audience check goes in the read rule here and in the
    // Storage folder. Data model: docs/data-model.md.

    // The six fixed reactions (❤️ 👏 🎉 😂 😮 👍), stored by name so the rules never compare emojis.
    function goodNewsReactions() {
      return ['heart', 'clap', 'party', 'laugh', 'wow', 'thumbsUp'];
    }

    // Whose good news it is: one's own, or for an adult, a child of their household (récit 32).
    function canPostFor(memberId) {
      return memberId == myMemberId()
        || (me().profile == 'adult'
            && get(memberPath(memberId)).data.profile != 'adult'
            && get(memberPath(memberId)).data.householdId == me().householdId);
    }

    // A photo id is the file name in Storage, without « .jpg » or « -thumb.jpg ».
    function isPhotoId(ids, i) {
      return ids.size() <= i || (ids[i] is string && ids[i].matches('^[A-Za-z0-9_]{1,40}$'));
    }

    // The 11 fields, and forChallenge and littleOnes at most. householdId is the household of the member the news is for, so a
    // chef de famille can remove it there without the rules reading another document.
    function isValidGoodNews(n) {
      return n.keys().hasAll(['text', 'photoIds', 'authorId', 'authorName', 'forMemberId', 'householdId',
                              'mentionIds', 'reactions', 'hiddenByIds', 'createdAt', 'updatedAt'])
        && n.keys().hasOnly(['text', 'photoIds', 'authorId', 'authorName', 'forMemberId', 'householdId',
                             'mentionIds', 'reactions', 'hiddenByIds', 'createdAt', 'updatedAt', 'forChallenge',
                             'littleOnes', 'commentCount'])
        // Linked to the challenge of a foyer (récit 35 bis): its month; the photo is already required.
        && (!('forChallenge' in n) || isMonthId(n.forChallenge))
        // « Les petits » (récit 43): only on a news an adult publishes for a child, never on one's own.
        && (!('littleOnes' in n) || (n.littleOnes == true && n.forMemberId != n.authorId))
        && n.text is string && n.text.trim().size() > 0 && n.text.size() <= 500
        && n.photoIds is list && n.photoIds.size() >= 1 && n.photoIds.size() <= 3
        && isPhotoId(n.photoIds, 0) && isPhotoId(n.photoIds, 1) && isPhotoId(n.photoIds, 2)
        && n.authorName is string && n.authorName.size() > 0 && n.authorName.size() <= 40
        && n.forMemberId is string
        && n.householdId == get(memberPath(n.forMemberId)).data.householdId
        && n.mentionIds is list && n.mentionIds.size() <= 20
        && n.reactions is map
        && n.hiddenByIds is list && n.hiddenByIds.size() <= 21
        && n.updatedAt == request.time;
    }

    // Remove (récit 32 and carte AVIS-12): the author, the responsible adults of the author or of
    // the member it is for, a chef de famille of that household, and the admin principal.
    function canRemoveGoodNews(n) {
      return n.authorId == myMemberId()
        || isParentOf(n.authorId)
        || (n.forMemberId != n.authorId && isParentOf(n.forMemberId))
        || managesHousehold(n.householdId);
    }

    // React: a member sets, changes or removes their own reaction, and nothing else. It does not
    // touch updatedAt, which the app shows as « modifiée ».
    function isGoodNewsReaction() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([myMemberId()])
        && (!(myMemberId() in request.resource.data.reactions)
            || request.resource.data.reactions[myMemberId()] in goodNewsReactions());
    }

    // « Masquer pour moi » (PRD rév. 158) : the member it is for, or a member named, adds or takes
    // back their own id in hiddenByIds, and nothing else. The others still see the post.
    function isGoodNewsHide() {
      return (resource.data.forMemberId == myMemberId() || myMemberId() in resource.data.mentionIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenByIds'])
        && request.resource.data.hiddenByIds is list
        && request.resource.data.hiddenByIds.size() <= 21
        && request.resource.data.hiddenByIds.toSet().difference(resource.data.hiddenByIds.toSet()).hasOnly([myMemberId()])
        && resource.data.hiddenByIds.toSet().difference(request.resource.data.hiddenByIds.toSet()).hasOnly([myMemberId()]);
    }

    // Modify: the author changes the text, the photos and the members named.
    function isGoodNewsEdit() {
      return resource.data.authorId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'photoIds', 'mentionIds', 'updatedAt'])
        && isValidGoodNews(request.resource.data);
    }

    match /goodNews/{postId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidGoodNews(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && canPostFor(request.resource.data.forMemberId)
        && request.resource.data.reactions.size() == 0
        && request.resource.data.hiddenByIds.size() == 0
        // commentCount is kept by the server alone (récit 67).
        && !('commentCount' in request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isMember() && (isGoodNewsReaction() || isGoodNewsHide() || isGoodNewsEdit());

      allow delete: if isMember() && canRemoveGoodNews(resource.data);
    }

    // goodNews/{postId}/comments/{commentId} (récit 67): every member reads the comments of a good
    // news and writes their own, a child with the app too, without approval (PRODUIT-102): a text
    // of 1 to 500 characters. They stay as long as the news and go with it (onGoodNewsDeleted). Its
    // author changes the text. Its author, the author of the news, a responsible adult of its
    // author, a chef de famille of the household of the news and the admin principal remove it.
    // The server counts them on the news (commentCount) and tells who is concerned.
    function newsOf(postId) {
      return get(/databases/$(database)/documents/goodNews/$(postId)).data;
    }

    match /goodNews/{postId}/comments/{commentId} {
      allow read: if isMember();
      allow create: if isMember()
        && exists(/databases/$(database)/documents/goodNews/$(postId))
        && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt', 'mentionIds'])
        && isCommentText(request.resource.data.text)
        && hasCommentMentions(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time;
      allow update: if isMember()
        && resource.data.authorId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentionIds'])
        && isCommentText(request.resource.data.text)
        && hasCommentMentions(request.resource.data)
        && request.resource.data.editedAt == request.time;
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId()
            || isParentOf(resource.data.authorId)
            || newsOf(postId).get('authorId', '') == myMemberId()
            || managesHousehold(newsOf(postId).get('householdId', '')));
    }

    // « Ne plus être prévenu » for the comments of a good news, as for an event.
    match /goodNews/{postId}/commentMutes/{memberId} {
      allow read: if isMember() && memberId == myMemberId();
      allow create: if isMember()
        && memberId == myMemberId()
        && request.resource.data.keys().hasOnly(['mutedAt'])
        && request.resource.data.mutedAt == request.time;
      allow delete: if isMember() && memberId == myMemberId();
    }

    // --- Bons plans et bonnes adresses (PRD, récit 45, PRODUIT-60) ------------------------------
    //
    // goodDeals/{dealId}: kind 'deal' (a bon plan: it leaves the list at endsAt, and the server
    // deletes it 30 days later) or 'address' (a bonne adresse: lasting, in a category). The adults
    // publish; the author and the admin principal change or remove. Every member reads them and
    // adds or removes only their own id: interestedIds on a deal (« Ça m'intéresse », children
    // too), recommendedIds on an address (« Je recommande aussi », adults but its author). The
    // photo of a deal is in Storage at goodDeals/{dealId}/{authorId}/; the server removes it with
    // the post. The audience is the whole family today (the circles change the read rule here).

    function isGoodDealText(t, min, max) {
      return t is string && t.trim().size() >= min && t.size() <= max;
    }

    function isGoodDealLink(l) {
      return l == null || (l is string && l.size() <= 500 && l.matches('^https?://[^ ]+$'));
    }

    function isGoodDealPhone(p) {
      return p == null || (p is string && p.matches('^[+]?[0-9 .()-]{4,20}$'));
    }

    // The photo of a deal: none, unchanged, or one the caller sent to their own folder of this deal.
    function isGoodDealPhoto(dealId, d, before) {
      return d.photo == null
        || (before != null && d.photo == before.photo)
        || (d.photo is string
            && d.photo.matches('^goodDeals/' + dealId + '/[A-Za-z0-9]{1,40}/[A-Za-z0-9]{1,40}$')
            && d.photo.split('/')[2] == myMemberId());
    }

    // A deal ends after now and within 3 months (92 days); an end left unchanged may have passed.
    function isGoodDealEnd(d, before) {
      return (before != null && d.endsAt == before.endsAt)
        || (d.endsAt is timestamp && d.endsAt > request.time && d.endsAt <= request.time + duration.value(92, 'd'));
    }

    function isValidGoodDeal(dealId, d, before) {
      return d.keys().hasAll(['kind', 'title', 'text', 'link', 'place', 'phone', 'category', 'endsAt', 'photo',
                              'interestedIds', 'recommendedIds', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['kind', 'title', 'text', 'link', 'place', 'phone', 'category', 'endsAt', 'photo',
                             'interestedIds', 'recommendedIds', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && isGoodDealText(d.title, 1, 80)
        && isGoodDealText(d.text, 0, 500)
        && isGoodDealLink(d.link)
        && (d.place == null || isGoodDealText(d.place, 1, 80))
        && d.interestedIds is list && d.recommendedIds is list
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 40
        && d.updatedAt == request.time
        && ((d.kind == 'deal' && d.category == null && d.phone == null
             && isGoodDealEnd(d, before) && isGoodDealPhoto(dealId, d, before))
            || (d.kind == 'address' && d.endsAt == null && d.photo == null && isGoodDealPhone(d.phone)
                && d.category in ['health', 'home', 'car', 'kids', 'outings', 'other']));
    }

    function canManageGoodDeal(d) {
      return d.authorId == myMemberId() || isOwner();
    }

    // The caller adds or removes their own id in [field], and nothing else changes.
    function isOwnGoodDealMark(field) {
      let before = resource.data[field];
      let after = request.resource.data[field];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && after is list && after.size() <= 100
        && ((after.toSet() == before.toSet().union([myMemberId()].toSet()) && after.size() == before.size() + 1)
            || (after.toSet() == before.toSet().difference([myMemberId()].toSet()) && after.size() == before.size() - 1));
    }

    function isGoodDealEdit(dealId) {
      return canManageGoodDeal(resource.data)
        && isValidGoodDeal(dealId, request.resource.data, resource.data)
        && request.resource.data.diff(resource.data).unchangedKeys()
             .hasAll(['kind', 'authorId', 'authorName', 'createdAt', 'interestedIds', 'recommendedIds']);
    }

    match /goodDeals/{dealId} {
      allow read: if isMember();

      allow create: if isMember()
        && me().profile == 'adult'
        && isValidGoodDeal(dealId, request.resource.data, null)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.interestedIds.size() == 0
        && request.resource.data.recommendedIds.size() == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && (isGoodDealEdit(dealId)
            || (resource.data.kind == 'deal' && isOwnGoodDealMark('interestedIds'))
            || (resource.data.kind == 'address' && resource.data.authorId != myMemberId()
                && me().profile == 'adult' && isOwnGoodDealMark('recommendedIds')));

      allow delete: if isMember() && canManageGoodDeal(resource.data);
    }

    // --- On se prête (PRD, récit 51) ------------------------------------------------------------
    //
    // lendItems/{itemId}: a thing an adult is happy to lend (« l'appareil à raclette »), in a
    // category, with an optional photo in Storage at lendItems/{itemId}/{ownerId}/. Every member
    // reads them; the adults add theirs; the owner and the admin principal change or remove one.
    // Everyone sees only `lent`: who asked or has it, and since when, live apart in
    // lendLoans/{itemId}, which only the owner, the borrower and the admin principal (for the
    // export) read (EXPERT-9, PRD rév. 268). The loan: an adult who is not the owner asks, in their
    // own name, with optional dates (the loan created and `lent` set to true, in one batch); the
    // owner says « D'accord » ('asked' to 'lent'); « Pas cette fois » (the owner), a dropped ask
    // (the borrower) or « Rendu » (either) remove the loan and set `lent` back to false, in one
    // batch. A child reads, never asks. No money anywhere. remindedAt is the server's (the one
    // reminder 3 days after « until »). The server removes the loan of a thing removed.

    function isLendText(t, min, max) {
      return t is string && t.trim().size() >= min && t.size() <= max;
    }

    function lendItemPath(itemId) {
      return /databases/$(database)/documents/lendItems/$(itemId);
    }

    function lendLoanPath(itemId) {
      return /databases/$(database)/documents/lendLoans/$(itemId);
    }

    // The photo: none, unchanged, or one the caller sent to their own folder of this item.
    function isLendPhoto(itemId, d, before) {
      return d.photo == null
        || (before != null && d.photo == before.photo)
        || (d.photo is string
            && d.photo.matches('^lendItems/' + itemId + '/[A-Za-z0-9]{1,40}/[A-Za-z0-9]{1,40}$')
            && d.photo.split('/')[2] == myMemberId());
    }

    function isValidLendItem(itemId, d, before) {
      return d.keys().hasAll(['name', 'note', 'category', 'photo', 'ownerId', 'ownerName', 'lent', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'note', 'category', 'photo', 'ownerId', 'ownerName', 'lent', 'createdAt', 'updatedAt'])
        && isLendText(d.name, 1, 60)
        && isLendText(d.note, 0, 300)
        && d.category in ['kitchen', 'diy', 'baby', 'sport', 'travel', 'other']
        && isLendPhoto(itemId, d, before)
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 40
        && d.lent is bool
        && d.updatedAt == request.time;
    }

    // The optional dates of an ask: none, or within a year, and the return not before the start.
    function isLendDates(d) {
      return (d.from == null || (d.from is timestamp && d.from <= request.time + duration.value(366, 'd')))
        && (d.until == null || (d.until is timestamp && d.until > request.time - duration.value(1, 'd')
                                && d.until <= request.time + duration.value(366, 'd')))
        && (d.from == null || d.until == null || d.until >= d.from);
    }

    // Only `lent` and the time change.
    function isLendFlip(from, to) {
      return resource.data.lent == from && request.resource.data.lent == to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lent', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // The owner edits the thing itself; `lent` stays as it is.
    function isLendEdit(itemId) {
      return (resource.data.ownerId == myMemberId() || isOwner())
        && isValidLendItem(itemId, request.resource.data, resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'note', 'category', 'photo', 'updatedAt']);
    }

    // The thing taken by an ask, created in the same batch in the caller's name.
    function isLendTaken(itemId) {
      return isLendFlip(false, true)
        && !exists(lendLoanPath(itemId))
        && existsAfter(lendLoanPath(itemId))
        && getAfter(lendLoanPath(itemId)).data.borrowerId == myMemberId();
    }

    // The thing free again, its loan removed in the same batch, by the owner or the borrower.
    function isLendFreed(itemId) {
      return isLendFlip(true, false)
        && !existsAfter(lendLoanPath(itemId))
        && (resource.data.ownerId == myMemberId()
            || (exists(lendLoanPath(itemId)) && get(lendLoanPath(itemId)).data.borrowerId == myMemberId()));
    }

    match /lendItems/{itemId} {
      allow read: if isMember();

      allow create: if isMember()
        && me().profile == 'adult'
        && isValidLendItem(itemId, request.resource.data, null)
        && request.resource.data.lent == false
        && request.resource.data.ownerId == myMemberId()
        && request.resource.data.ownerName == me().firstName
        && request.resource.data.createdAt == request.time;

      allow update: if isMember() && (isLendEdit(itemId) || isLendTaken(itemId) || isLendFreed(itemId));

      allow delete: if isMember() && (resource.data.ownerId == myMemberId() || isOwner());
    }

    // lendLoans/{itemId}: the ask, then the loan, of one thing. `parties` is [ownerId, borrowerId],
    // for the app to read its own with one query.
    function isValidLendAsk(itemId, d) {
      let item = get(lendItemPath(itemId)).data;
      return d.keys().hasAll(['ownerId', 'parties', 'status', 'borrowerId', 'borrowerName', 'from', 'until',
                              'askedAt', 'lentAt', 'remindedAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerId', 'parties', 'status', 'borrowerId', 'borrowerName', 'from', 'until',
                             'askedAt', 'lentAt', 'remindedAt', 'updatedAt'])
        && me().profile == 'adult'
        && item.lent == false
        && getAfter(lendItemPath(itemId)).data.lent == true
        && item.ownerId != myMemberId()
        && d.ownerId == item.ownerId
        && d.borrowerId == myMemberId()
        && d.borrowerName == me().firstName
        && d.parties == [item.ownerId, myMemberId()]
        && d.status == 'asked'
        && isLendDates(d)
        && d.askedAt == request.time
        && d.lentAt == null && d.remindedAt == null
        && d.updatedAt == request.time;
    }

    match /lendLoans/{itemId} {
      allow read: if isMember() && (myMemberId() in resource.data.parties || isOwner());

      // « Je voudrais l'emprunter », with the thing taken in the same batch.
      allow create: if isMember() && exists(lendItemPath(itemId)) && isValidLendAsk(itemId, request.resource.data);

      // « D'accord »: the owner lends to the one who asked, with their dates.
      allow update: if isMember()
        && resource.data.status == 'asked'
        && resource.data.ownerId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lentAt', 'updatedAt'])
        && request.resource.data.status == 'lent'
        && request.resource.data.lentAt == request.time
        && request.resource.data.updatedAt == request.time;

      // « Pas cette fois », a dropped ask or « Rendu », with the thing freed in the same batch. A
      // loan already gone (a thing left « Prêté » with none) deletes as nothing, so the owner can
      // still free the thing: isLendFreed lets them.
      allow delete: if isMember()
        && (resource == null || resource.data.ownerId == myMemberId() || resource.data.borrowerId == myMemberId())
        && existsAfter(lendItemPath(itemId))
        && getAfter(lendItemPath(itemId)).data.lent == false;
    }

    // --- À qui le tour ? (PRD, récit 58), supprimé le 20/11 ---------------------------------------
    //
    // turns/{turnId} and whatever lies under it are erased once by the Cloud Functions (turns.ts),
    // then nobody reads or writes there any more.

    match /turns/{document=**} {
      allow read, write: if false;
    }

    // --- Vœux d'anniversaire (PRD, récit 36, avis EXPERT n° 11) ---------------------------------
    //
    // birthdayCards/{year}-{forMemberId}-{authorId}: one card per member and per birthday, a short
    // word to the person celebrated. It can be written only on the day: within 24 h of the Bonne
    // nouvelle goodNews/birthday-{year}-{forMemberId} that Familia publishes that morning. The whole
    // family reads the cards (the person's page, the Bonne nouvelle); the author changes or removes
    // theirs. Nobody else writes one, and the app never shows how many there are.

    function isBirthdayCardText(t) {
      return t is string && t.trim().size() > 0 && t.size() <= 280;
    }

    // The day: the Bonne nouvelle of Familia exists and was published less than 24 h ago.
    function isBirthdayToday(year, forMemberId) {
      let news = /databases/$(database)/documents/goodNews/$('birthday-' + string(year) + '-' + forMemberId);
      return exists(news) && get(news).data.createdAt > request.time - duration.value(24, 'h');
    }

    match /birthdayCards/{cardId} {
      allow read: if isMember();

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['forMemberId', 'authorId', 'authorName', 'text', 'year', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['forMemberId', 'authorId', 'authorName', 'text', 'year', 'createdAt', 'updatedAt'])
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.forMemberId is string
        && request.resource.data.forMemberId != myMemberId()
        && request.resource.data.year is int
        && cardId == string(request.resource.data.year) + '-' + request.resource.data.forMemberId + '-' + myMemberId()
        && isBirthdayToday(request.resource.data.year, request.resource.data.forMemberId)
        && isBirthdayCardText(request.resource.data.text)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isMember()
        && resource.data.authorId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
        && isBirthdayCardText(request.resource.data.text)
        && request.resource.data.updatedAt == request.time;

      allow delete: if isMember() && resource.data.authorId == myMemberId();
    }

    // --- Pensez à moi (PRD, récit 43), retiré (PRODUIT-136, 19/11) --------------------------------
    //
    // moments/{id} and momentCheers/{momentId}-{authorId} stay in the database, closed to any new
    // write. What is there is still read as before, and removed by its author (or the person).

    match /moments/{momentId} {
      allow read: if isMember()
        && (resource.data.status == 'accepted'
            || resource.data.forMemberId == myMemberId()
            || resource.data.authorId == myMemberId()
            || isParentOf(resource.data.forMemberId));

      allow delete: if isMember()
        && (resource.data.forMemberId == myMemberId() || resource.data.authorId == myMemberId());
    }

    match /momentCheers/{cheerId} {
      allow read: if isMember();

      allow delete: if isMember() && resource.data.authorId == myMemberId();
    }

    // --- Sondages (PRD, récits 2 bis et 2 ter) ---------------------------------------------------
    //
    // polls/{pollId}: a date poll (2 to 5 dates, each answered yes, maybe or no) or a free poll
    // (2 to 6 texts, one or several choices). An adult asks the whole family or the members ticked
    // (askedIds); viewerIds is the author, then the members asked and the responsible adults of the
    // children asked, so the app reads its polls with array-contains. The question and its options
    // never change once asked, so the votes always match them. Data model: docs/data-model.md.

    function isPollOption(kind, options, i) {
      return options.size() <= i
        || (options[i] is string
            && ((kind == 'date' && options[i].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}( ([01][0-9]|2[0-3]):[0-5][0-9])?$'))
                || (kind == 'choice' && options[i].trim().size() > 0 && options[i].size() <= 80)));
    }

    // The 15 fields exactly. createdEventId is the event made from the date chosen (isPollClose).
    function isValidPoll(p) {
      return p.keys().hasAll(['kind', 'question', 'options', 'multiple', 'askedIds', 'viewerIds', 'eventId',
                              'closesAt', 'closed', 'chosen', 'createdEventId', 'authorId', 'authorName',
                              'createdAt', 'updatedAt'])
        && p.keys().size() == 15
        && p.kind in ['date', 'choice']
        && p.question is string && p.question.trim().size() > 0 && p.question.size() <= 120
        && p.options is list && p.options.size() >= 2
        && p.options.size() <= (p.kind == 'date' ? 5 : 6)
        && isPollOption(p.kind, p.options, 0) && isPollOption(p.kind, p.options, 1)
        && isPollOption(p.kind, p.options, 2) && isPollOption(p.kind, p.options, 3)
        && isPollOption(p.kind, p.options, 4) && isPollOption(p.kind, p.options, 5)
        && p.multiple is bool && (p.kind == 'choice' || p.multiple == false)
        && p.askedIds is list && p.askedIds.size() >= 1 && p.askedIds.size() <= 30
        && p.viewerIds is list && p.viewerIds.size() <= 40 && p.viewerIds[0] == p.authorId
        && p.viewerIds.hasAll(p.askedIds)
        && (p.eventId == null || (p.eventId is string && exists(/databases/$(database)/documents/events/$(p.eventId))))
        && (p.closesAt == null || p.closesAt is timestamp)
        && p.closed is bool
        && (p.chosen == null || (p.chosen is int && p.chosen >= 0 && p.chosen < p.options.size()))
        && p.authorName is string && p.authorName.size() > 0 && p.authorName.size() <= 40
        && p.updatedAt == request.time;
    }

    function pollPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId);
    }

    // Votes are taken until the author closes the poll, or until its end date.
    function pollIsOpen(poll) {
      return poll.closed == false && (poll.closesAt == null || request.time < poll.closesAt);
    }

    // Close, or for a date poll choose the date (which closes it too): the author or the admin
    // principal, and only those fields. Choosing a date links the event the app has just created
    // for it (createdEventId, by the same member); the server then signs up those who said yes.
    function isPollClose() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'chosen', 'createdEventId', 'updatedAt'])
        && request.resource.data.closed == true
        && ((request.resource.data.chosen == resource.data.chosen
             && request.resource.data.createdEventId == resource.data.createdEventId)
            || (resource.data.kind == 'date' && resource.data.chosen == null
                && request.resource.data.chosen != null
                && request.resource.data.createdEventId is string
                && get(/databases/$(database)/documents/events/$(request.resource.data.createdEventId)).data.authorId == myMemberId()))
        && isValidPoll(request.resource.data);
    }

    match /polls/{pollId} {
      allow read: if isMember() && (myMemberId() in resource.data.viewerIds || isOwner());

      // A child with the app votes but does not ask (PRD, droits d'un enfant).
      allow create: if isMember()
        && me().profile == 'adult'
        && isValidPoll(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.closed == false
        && request.resource.data.chosen == null
        && request.resource.data.createdEventId == null
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && (resource.data.authorId == myMemberId() || isOwner())
        && isPollClose();

      allow delete: if isMember() && (resource.data.authorId == myMemberId() || isOwner());
    }

    function isDateAnswer(answers, i) {
      return answers.size() <= i || answers[i] in ['yes', 'maybe', 'no'];
    }

    function isChoice(choices, i, count) {
      return choices.size() <= i || (choices[i] is int && choices[i] >= 0 && choices[i] < count);
    }

    // A date poll: one answer per date, in order. A free poll: the indexes chosen, one only
    // unless the author allowed several.
    function isValidVote(v, memberId, poll) {
      return v.memberId == memberId
        && v.votedBy == myMemberId()
        && v.updatedAt == request.time
        && v.keys().size() == 4
        && ((poll.kind == 'date'
             && v.keys().hasAll(['memberId', 'answers', 'votedBy', 'updatedAt'])
             && v.answers is list && v.answers.size() == poll.options.size()
             && isDateAnswer(v.answers, 0) && isDateAnswer(v.answers, 1) && isDateAnswer(v.answers, 2)
             && isDateAnswer(v.answers, 3) && isDateAnswer(v.answers, 4))
            || (poll.kind == 'choice'
                && v.keys().hasAll(['memberId', 'choices', 'votedBy', 'updatedAt'])
                && v.choices is list && v.choices.size() >= 1
                && v.choices.size() <= (poll.multiple ? poll.options.size() : 1)
                && v.choices.toSet().size() == v.choices.size()
                && isChoice(v.choices, 0, poll.options.size()) && isChoice(v.choices, 1, poll.options.size())
                && isChoice(v.choices, 2, poll.options.size()) && isChoice(v.choices, 3, poll.options.size())
                && isChoice(v.choices, 4, poll.options.size()) && isChoice(v.choices, 5, poll.options.size())));
    }

    // polls/{pollId}/votes/{memberId}: visible to everyone who sees the poll (votes are named,
    // PRD 2 ter), written by the member asked or one of their responsible adults while it is open.
    match /polls/{pollId}/votes/{memberId} {
      allow read: if isMember()
        && (myMemberId() in get(pollPath(pollId)).data.viewerIds || isOwner());
      allow create, update: if isMember()
        && canAnswerFor(memberId)
        && memberId in get(pollPath(pollId)).data.askedIds
        && pollIsOpen(get(pollPath(pollId)).data)
        && isValidVote(request.resource.data, memberId, get(pollPath(pollId)).data);
      allow delete: if isMember()
        && canAnswerFor(memberId)
        && pollIsOpen(get(pollPath(pollId)).data);
    }

    // --- Listes et cadeaux (V2) -------------------------------------------------------------------
    //
    // PRD, récits 7 à 10 bis. The surprise is kept by the server, not by the app: the beneficiary
    // of a list never reads a surprise list made for them, the items others add to their own list,
    // the reservations or the shares of a joint gift, until the list is revealed the day after the
    // occasion (`revealed`, written only by the Cloud Function). Data model: docs/data-model.md.

    function giftListPath(listId) {
      return /databases/$(database)/documents/giftLists/$(listId);
    }

    // The caller keeps the lists of [memberId]: their own, or those of a child without the app
    // they are a responsible adult of (PRD, récit 7).
    function keepsListsOf(memberId) {
      return memberId == myMemberId()
        || (exists(memberPath(memberId))
            && get(memberPath(memberId)).data.profile == 'childWithoutApp'
            && myMemberId() in get(memberPath(memberId)).data.parentIds);
    }

    // Who sees a list. « Mes envies » is open to the whole family; any other list to the members
    // checked in viewerIds. The beneficiary is never among the viewers of a surprise list, and
    // only reads it once it is revealed. Written as a plain OR so the app's queries can be proven.
    function canSeeList(l) {
      return l.kind == 'wishes'
        // « Idées de la famille » (récit 9 ter): the whole family but the person, never revealed to them.
        || (l.kind == 'ideas' && l.beneficiaryId != myMemberId())
        || myMemberId() in l.viewerIds
        || (l.beneficiaryId == myMemberId() && l.revealed == true);
    }

    // The beneficiary does not see what the others do on their list before it is revealed.
    function isKeptFromMe(l) {
      return l.beneficiaryId == myMemberId() && l.revealed != true;
    }

    // Récit 73, « Cadeau commun avec… »: a wish of « Mes envies » shared with a member of the household
    // of its beneficiary, its coBeneficiaryId. The list names everyone who shares one of its wishes in
    // coBeneficiaryIds, a list that only grows: they may not list its reservations, only read one by
    // one those of the wishes they do not share. Like the beneficiary, they never learn that their
    // shared wish is reserved, nor by whom.
    function sharesAWishOf(l) {
      return myMemberId() in l.get('coBeneficiaryIds', []);
    }

    function itemDocPath(listId, itemId) {
      return /databases/$(database)/documents/giftLists/$(listId)/items/$(itemId);
    }

    // The caller shares the wish [itemId] of [listId]. A removed wish is shared with nobody.
    function sharesWish(listId, itemId) {
      return exists(itemDocPath(listId, itemId))
        && get(itemDocPath(listId, itemId)).data.get('coBeneficiaryId', null) == myMemberId();
    }

    // Whoever shares a wish of the list [l] reads the reservation of [itemId] only if it is a wish
    // that exists and that they do not share: a removed wish may have been theirs.
    function readsReservationOf(l, listId, itemId) {
      return !sharesAWishOf(l)
        || (exists(itemDocPath(listId, itemId))
            && get(itemDocPath(listId, itemId)).data.get('coBeneficiaryId', null) != myMemberId());
    }

    // The member [memberId] may share a wish of the list [l]: another member of the same household.
    function canShareWishWith(l, memberId) {
      return l.kind == 'wishes'
        && memberId is string
        && memberId != l.beneficiaryId
        && exists(memberPath(memberId))
        && get(memberPath(memberId)).data.householdId == get(memberPath(l.beneficiaryId)).data.householdId;
    }

    // The creator manages a list; the keeper of the beneficiary manages their own list and wishes.
    function canManageList(l) {
      return l.creatorId == myMemberId() || (!(l.kind in ['surprise', 'ideas']) && keepsListsOf(l.beneficiaryId));
    }

    // The two permanent lists of a member (récit 9 ter): their wishes, and the ideas of the family.
    function isPermanentList(kind) {
      return kind in ['wishes', 'ideas'];
    }

    function isValidGiftList(l) {
      return l.keys().hasAll(['kind', 'title', 'occasion', 'date', 'beneficiaryId', 'viewerIds',
                              'creatorId', 'creatorName', 'revealed', 'createdAt', 'updatedAt'])
        && l.keys().hasOnly(['kind', 'title', 'occasion', 'date', 'beneficiaryId', 'viewerIds',
                             'creatorId', 'creatorName', 'revealed', 'createdAt', 'updatedAt', 'coBeneficiaryIds'])
        && l.kind in ['wishes', 'own', 'surprise', 'ideas']
        // Récit 73: who shares a wish of this list (see coBeneficiaryId on the items), on « Mes envies » only.
        && (!('coBeneficiaryIds' in l) || (l.kind == 'wishes' && l.coBeneficiaryIds is list && l.coBeneficiaryIds.size() <= 20))
        && l.title is string && l.title.size() > 0 && l.title.size() <= 60
        && l.beneficiaryId is string && exists(memberPath(l.beneficiaryId))
        && l.viewerIds is list && l.viewerIds.size() <= 40
        && l.creatorName is string && l.creatorName.size() > 0 && l.creatorName.size() <= 40
        && l.revealed is bool
        && l.updatedAt == request.time
        && ((isPermanentList(l.kind) && l.occasion == null && l.date == null && l.viewerIds.size() == 0)
            || (!isPermanentList(l.kind)
                && l.occasion in ['christmas', 'birthday', 'birth', 'other']
                && isDay(l.date)
                && myMemberId() in l.viewerIds
                && (l.kind != 'own'
                    || (l.beneficiaryId in l.viewerIds
                        // The responsible adults of a child always see the child's own list.
                        && l.viewerIds.hasAll(get(memberPath(l.beneficiaryId)).data.parentIds)))
                && (l.kind != 'surprise'
                    || (!(l.beneficiaryId in l.viewerIds) && l.beneficiaryId != myMemberId()))));
    }

    // giftLists/{listId}. « Mes envies » of a member has the id wishes-{memberId}, so there is one.
    match /giftLists/{listId} {
      allow read: if isMember() && canSeeList(resource.data);

      allow create: if isMember()
        && isValidGiftList(request.resource.data)
        && request.resource.data.creatorId == myMemberId()
        && request.resource.data.creatorName == me().firstName
        && request.resource.data.revealed == false
        && request.resource.data.createdAt == request.time
        && (request.resource.data.kind == 'surprise'
            // The ideas of the family: by anyone but the person, at its one id.
            || (request.resource.data.kind == 'ideas'
                && request.resource.data.beneficiaryId != myMemberId()
                && listId == 'ideas-' + request.resource.data.beneficiaryId)
            || (request.resource.data.kind != 'ideas'
                && keepsListsOf(request.resource.data.beneficiaryId)
                && (request.resource.data.kind != 'wishes'
                    || listId == 'wishes-' + request.resource.data.beneficiaryId)));

      // The kind, the beneficiary, the creator and the reveal never change from the app, and a
      // revealed list is archived: read-only.
      allow update: if isMember()
        && resource.data.revealed == false
        && canManageList(resource.data)
        && isValidGiftList(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.beneficiaryId == resource.data.beneficiaryId
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.revealed == resource.data.revealed
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('coBeneficiaryIds', []).hasAll(resource.data.get('coBeneficiaryIds', []));

      // « Mes envies » is permanent. Items, reservations and shares are removed on the server.
      allow delete: if isMember() && !isPermanentList(resource.data.kind) && canManageList(resource.data);
    }

    function isValidGiftItem(i) {
      return i.keys().hasAll(['title', 'url', 'price', 'note', 'authorId', 'authorName',
                              'visibleToBeneficiary', 'createdAt', 'updatedAt'])
        && i.keys().hasOnly(['title', 'url', 'price', 'note', 'authorId', 'authorName',
                             'visibleToBeneficiary', 'createdAt', 'updatedAt', 'imageUrl', 'occasion', 'photo',
                             'alreadyBought', 'contributedTotal', 'coBeneficiaryId'])
        // « Déjà acheté, participation bienvenue » (récit 68): a bool, and the total of the
        // participations in whole euros, kept by those who take part (see contributions below).
        && (!('alreadyBought' in i) || i.alreadyBought is bool)
        && (!('contributedTotal' in i) || (i.contributedTotal is int && i.contributedTotal >= 0))
        // The occasion a wish is for (récit 9 ter): absent or null for « Quand tu veux ».
        && (!('occasion' in i) || i.occasion == null || i.occasion in ['christmas', 'birthday'])
        && i.title is string && i.title.size() > 0 && i.title.size() <= 80
        && (i.url == null || (i.url is string && i.url.size() <= 500 && i.url.matches('^https?://.+')))
        && (i.price == null || (i.price is number && i.price >= 0 && i.price <= 100000))
        && (i.note == null || (i.note is string && i.note.size() <= 500))
        // Optional picture of a shared link (carte PRODUIT-34), never a file stored by Familia.
        && (!('imageUrl' in i) || i.imageUrl == null
            || (i.imageUrl is string && i.imageUrl.size() <= 1000 && i.imageUrl.matches('^https://.+')))
        && i.authorName is string && i.authorName.size() > 0 && i.authorName.size() <= 40
        && i.visibleToBeneficiary is bool
        && i.updatedAt == request.time;
    }

    // Plus de photos (PRD, récit 44): photo, optional, names the photo its author sent to Storage
    // beforehand, giftLists/{listId}/{folder}/{authorId}/{photoId} (storage.rules). The folder says
    // who reads it there: « shared » for an item the beneficiary sees, « hidden » for an idea kept
    // from them, so an idea can never name a photo that the beneficiary may download.
    function isValidItemPhoto(listId, i, before) {
      return !('photo' in i) || i.photo == null
        || (before != null && 'photo' in before && i.photo == before.photo)
        || (i.photo is string
            && i.photo.matches('^giftLists/' + listId + '/' + (i.visibleToBeneficiary ? 'shared' : 'hidden')
                               + '/' + myMemberId() + '/[A-Za-z0-9]{1,40}$'));
    }

    // giftLists/{listId}/items/{itemId}. An item added by someone other than the keeper of the
    // beneficiary is a surprise idea: visibleToBeneficiary is false, and the beneficiary never
    // reads it before the reveal (PRD, récit 8).
    match /giftLists/{listId}/items/{itemId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      function claimPath() {
        return /databases/$(database)/documents/giftLists/$(listId)/claims/$(itemId);
      }

      function myContributionPath() {
        return /databases/$(database)/documents/giftLists/$(listId)/items/$(itemId)/contributions/$(myMemberId());
      }

      // Récit 73: absent or null, or another member of the household, whom the list names in the same
      // write (coBeneficiaryIds), so that from then on they may not list its reservations.
      function isValidCoBeneficiary(i) {
        return i.get('coBeneficiaryId', null) == null
          || (canShareWishWith(list(), i.coBeneficiaryId)
              && i.visibleToBeneficiary == true
              && i.coBeneficiaryId in getAfter(giftListPath(listId)).data.get('coBeneficiaryIds', []));
      }

      // Récit 68: « Déjà acheté » only on a wish its keeper sees, and never with a total of its own.
      function isValidAlreadyBought(i) {
        return i.get('alreadyBought', false) == false
          || (list().kind == 'wishes' && i.visibleToBeneficiary == true);
      }

      allow read: if isMember()
        && canSeeList(list())
        && (!isKeptFromMe(list()) || resource.data.visibleToBeneficiary == true);

      allow create: if isMember()
        && exists(giftListPath(listId))
        && canSeeList(list())
        && list().revealed == false
        && isValidGiftItem(request.resource.data)
        && isValidItemPhoto(listId, request.resource.data, null)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && isValidAlreadyBought(request.resource.data)
        && isValidCoBeneficiary(request.resource.data)
        && !('contributedTotal' in request.resource.data)
        && request.resource.data.visibleToBeneficiary
             == (!(list().kind in ['surprise', 'ideas']) && keepsListsOf(list().beneficiaryId));

      // The author edits or removes their item until it is reserved. The beneficiary's side may
      // always do it: refusing would tell them that the item is reserved. The Cloud Function then
      // warns whoever had reserved it.
      allow update: if isMember()
        && resource.data.authorId == myMemberId()
        && list().revealed == false
        && (resource.data.visibleToBeneficiary == true || !exists(claimPath()))
        && isValidGiftItem(request.resource.data)
        && isValidItemPhoto(listId, request.resource.data, resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.visibleToBeneficiary == resource.data.visibleToBeneficiary
        && request.resource.data.createdAt == resource.data.createdAt
        // The total belongs to those who take part; « Déjà acheté » stays while someone does.
        && request.resource.data.get('contributedTotal', 0) == resource.data.get('contributedTotal', 0)
        && isValidAlreadyBought(request.resource.data)
        && isValidCoBeneficiary(request.resource.data)
        // Once shared, a wish stays shared with the same member: otherwise they would read its reservation.
        && (resource.data.get('coBeneficiaryId', null) == null
            || request.resource.data.get('coBeneficiaryId', null) == resource.data.coBeneficiaryId)
        && (request.resource.data.get('alreadyBought', false) == true
            || resource.data.get('contributedTotal', 0) == 0);

      // Récit 73: whoever shares the wish, or keeps the lists of a child who does, edits it too, as its
      // author would, without changing who shares it. Never refused for a reservation: it would tell.
      allow update: if isMember()
        && list().kind == 'wishes'
        && list().revealed == false
        && resource.data.get('coBeneficiaryId', null) != null
        && keepsListsOf(resource.data.coBeneficiaryId)
        && isValidGiftItem(request.resource.data)
        && isValidItemPhoto(listId, request.resource.data, resource.data)
        && request.resource.data.coBeneficiaryId == resource.data.coBeneficiaryId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.visibleToBeneficiary == resource.data.visibleToBeneficiary
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('contributedTotal', 0) == resource.data.get('contributedTotal', 0)
        && isValidAlreadyBought(request.resource.data)
        && (request.resource.data.get('alreadyBought', false) == true
            || resource.data.get('contributedTotal', 0) == 0);

      // Récit 68: whoever takes part changes the total by their own part, in the same write as it.
      allow update: if isMember()
        && list().kind == 'wishes'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contributedTotal'])
        && request.resource.data.contributedTotal is int
        && request.resource.data.contributedTotal
             == resource.data.get('contributedTotal', 0)
                - (exists(myContributionPath()) ? get(myContributionPath()).data.amount : 0)
                + (existsAfter(myContributionPath()) ? getAfter(myContributionPath()).data.amount : 0);

      // A revealed list is archived: nothing leaves it any more.
      allow delete: if isMember()
        && resource.data.authorId == myMemberId()
        && list().revealed == false
        && (resource.data.visibleToBeneficiary == true || !exists(claimPath()));
    }

    // giftLists/{listId}/claims/{itemId}: the reservation of an item, one at most (PRD, récit 9).
    // « Je le prends » (solo) or a joint gift (shared) opened by its responsible, the holder.
    // A child with the app reserves alone, never a joint gift (carte PRODUIT-19).
    match /giftLists/{listId}/claims/{itemId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      // Récit 73: whoever shares a wish of the list reads its reservations one by one, never theirs.
      allow get: if isMember() && canSeeList(list()) && !isKeptFromMe(list())
        && readsReservationOf(list(), listId, itemId);
      allow list: if isMember() && canSeeList(list()) && !isKeptFromMe(list()) && !sharesAWishOf(list());

      allow create: if isMember()
        && exists(giftListPath(listId))
        && canSeeList(list())
        && list().revealed == false
        && list().beneficiaryId != myMemberId()
        && !sharesWish(listId, itemId)
        && exists(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId))
        && request.resource.data.keys().hasAll(['type', 'holderId', 'holderName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'holderId', 'holderName', 'createdAt'])
        && request.resource.data.type in ['solo', 'shared']
        && request.resource.data.holderId == myMemberId()
        && request.resource.data.holderName == me().firstName
        && request.resource.data.createdAt == request.time
        && (request.resource.data.type == 'solo' || me().profile == 'adult')
        // Récit 68: a wish already bought is never reserved, one only takes part in it.
        && get(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId)).data.get('alreadyBought', false) != true;

      // On « Mes envies », the holder chooses the occasion the gift is meant for (PRD rév. 186):
      // the next birthday or the next Christmas after the reservation, revealed the day after.
      // Without a choice, the server takes whichever comes first.
      allow update: if isMember()
        && resource.data.holderId == myMemberId()
        && isPermanentList(list().kind)
        && list().revealed == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occasion'])
        && request.resource.data.occasion in ['birthday', 'christmas'];

      // The holder releases the item; the shares of a joint gift are removed on the server.
      allow delete: if isMember() && resource.data.holderId == myMemberId() && list().revealed == false;
    }

    function isValidShare(s) {
      return s.keys().hasAll(['amount', 'memberName', 'received', 'updatedAt'])
        && s.keys().hasOnly(['amount', 'memberName', 'received', 'updatedAt'])
        && s.amount is number && s.amount > 0 && s.amount <= 10000
        && s.memberName is string && s.memberName.size() > 0 && s.memberName.size() <= 40
        && s.received is bool
        && s.updatedAt == request.time;
    }

    // giftLists/{listId}/claims/{itemId}/shares/{memberId}: a part of a joint gift. Each adult
    // declares their own; the responsible (the holder) marks it received. No real payment.
    // The amount of a part is read by its author and the responsible only, even after the reveal
    // (PRD rév. 151): the others see the total that the server keeps on the reservation.
    match /giftLists/{listId}/claims/{itemId}/shares/{memberId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      function claim() {
        return get(/databases/$(database)/documents/giftLists/$(listId)/claims/$(itemId)).data;
      }

      allow read: if isMember() && canSeeList(list()) && !isKeptFromMe(list())
        && readsReservationOf(list(), listId, itemId)
        && (memberId == myMemberId() || claim().holderId == myMemberId());

      allow create: if isMember()
        && memberId == myMemberId()
        && me().profile == 'adult'
        && canSeeList(list())
        && list().revealed == false
        && list().beneficiaryId != myMemberId()
        && !sharesWish(listId, itemId)
        && claim().type == 'shared'
        && isValidShare(request.resource.data)
        && request.resource.data.memberName == me().firstName
        && request.resource.data.received == false;

      // The member changes their amount; the responsible marks the share received or not.
      allow update: if isMember()
        && list().revealed == false
        && isValidShare(request.resource.data)
        && ((memberId == myMemberId()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'updatedAt']))
            || (claim().holderId == myMemberId()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['received', 'updatedAt'])));

      allow delete: if isMember() && (memberId == myMemberId() || claim().holderId == myMemberId());
    }

    // giftLists/{listId}/items/{itemId}/contributions/{memberId}: « Je participe » on a wish its
    // keeper already bought (récit 68), in whole euros. Not a surprise: whoever keeps the lists of
    // the person reads every first name and amount; the others only their own part, and the total
    // on the item. Each write changes the total of the item by the same amount, in one batch.
    match /giftLists/{listId}/items/{itemId}/contributions/{memberId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      function itemPath() {
        return /databases/$(database)/documents/giftLists/$(listId)/items/$(itemId);
      }

      function totalBefore() {
        return get(itemPath()).data.get('contributedTotal', 0);
      }

      function totalAfter() {
        return getAfter(itemPath()).data.get('contributedTotal', 0);
      }

      allow read: if isMember()
        && list().kind == 'wishes'
        && (memberId == myMemberId() || keepsListsOf(list().beneficiaryId));

      allow create, update: if isMember()
        && memberId == myMemberId()
        && me().profile == 'adult'
        && list().kind == 'wishes'
        && !keepsListsOf(list().beneficiaryId)
        && get(itemPath()).data.get('coBeneficiaryId', null) != myMemberId()
        && get(itemPath()).data.get('alreadyBought', false) == true
        && request.resource.data.keys().hasAll(['amount', 'memberName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['amount', 'memberName', 'updatedAt'])
        && request.resource.data.amount is int
        && request.resource.data.amount > 0 && request.resource.data.amount <= 10000
        && request.resource.data.memberName == me().firstName
        && request.resource.data.updatedAt == request.time
        && totalAfter() == totalBefore() - (resource == null ? 0 : resource.data.amount) + request.resource.data.amount;

      // Taking one's part back lowers the total by as much.
      allow delete: if isMember()
        && memberId == myMemberId()
        && totalAfter() == totalBefore() - resource.data.amount;
    }

    // giftLists/{listId}/received/{itemId}: « On m'a offert » (récit 10 bis), the wishes revealed
    // the day after an occasion, written by the Cloud Function only. Its owner and the adults who
    // keep their lists read it; the owner may only say thank you.
    function isSelfReceived(r, item) {
      return r.keys().hasOnly(['title', 'url', 'imageUrl', 'giverIds', 'givers', 'joint', 'occasion', 'year',
                               'thanked', 'revealedAt', 'self'])
        && r.keys().hasAll(['title', 'url', 'imageUrl', 'giverIds', 'givers', 'joint', 'occasion', 'year',
                            'thanked', 'revealedAt', 'self'])
        && r.title == item.title
        && r.url == item.get('url', null)
        && r.imageUrl == item.get('imageUrl', null)
        && r.giverIds == [] && r.givers == [] && r.joint == false
        && r.occasion == null && r.year == null
        && r.thanked == false && r.revealedAt == request.time && r.self == true;
    }

    match /giftLists/{listId}/received/{itemId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      allow read: if isMember() && list().kind == 'wishes' && keepsListsOf(list().beneficiaryId);

      // « Reçue » (rév. 232): whoever keeps the lists of the person archives a wish of « Mes envies »
      // they say they got, in the same batch as its removal. Nobody gave it through the list: no
      // giver, no thanks. A reservation of it is cancelled, and its holder told, by the server.
      allow create: if isMember()
        && list().kind == 'wishes'
        && keepsListsOf(list().beneficiaryId)
        && exists(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId))
        && get(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId)).data.visibleToBeneficiary == true
        && !existsAfter(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId))
        && isSelfReceived(request.resource.data,
                          get(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId)).data);

      allow update: if isMember()
        && list().beneficiaryId == myMemberId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thanked', 'thankedAt'])
        && request.resource.data.thanked == true
        && request.resource.data.thankedAt == request.time;
    }

    // --- Mon carnet de cadeaux (PRD, récit 9 bis) ----------------------------------------------
    //
    // notebooks/{memberId}: what a member plans to give. Only that member reads or writes it: not
    // the person who receives, not the admin principal, not anyone acting for them. The entries
    // of a reservation or of a part of a joint gift are written by the Cloud Function; the member
    // only follows them (state, occasion, note). Data model: docs/data-model.md.

    function isNotebookOwner(memberId) {
      return isMember() && memberId == myMemberId();
    }

    // What the member may set on any entry, a private idea or a reservation taken up.
    function isValidNotebookFollowUp(e) {
      return e.status in ['idea', 'bought', 'wrapped', 'given']
        && (e.occasion == null || e.occasion in ['christmas', 'birthday', 'birth', 'other'])
        && (e.year == null || (e.year is int && e.year >= 2020 && e.year <= 2100))
        && (e.note == null || (e.note is string && e.note.size() <= 500))
        && e.updatedAt == request.time;
    }

    function isValidNotebookIdea(e) {
      return e.keys().hasAll(['source', 'personId', 'personName', 'occasion', 'year', 'title', 'url',
                              'price', 'note', 'status', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['source', 'personId', 'personName', 'occasion', 'year', 'title', 'url',
                             'price', 'note', 'status', 'createdAt', 'updatedAt'])
        && e.source == 'idea'
        // Someone of the family, or a person outside it known by their first name only.
        && (e.personId == null || (e.personId is string && exists(memberPath(e.personId))))
        && e.personName is string && e.personName.size() > 0 && e.personName.size() <= 40
        && e.title is string && e.title.size() > 0 && e.title.size() <= 80
        && (e.url == null || (e.url is string && e.url.size() <= 500 && e.url.matches('^https?://.+')))
        && (e.price == null || (e.price is number && e.price >= 0 && e.price <= 100000))
        && isValidNotebookFollowUp(e);
    }

    match /notebooks/{memberId}/entries/{entryId} {
      allow read: if isNotebookOwner(memberId);

      allow create: if isNotebookOwner(memberId)
        && isValidNotebookIdea(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isNotebookOwner(memberId)
        && request.resource.data.source == resource.data.source
        && request.resource.data.createdAt == resource.data.createdAt
        && ((resource.data.source == 'idea' && isValidNotebookIdea(request.resource.data))
            || (resource.data.source != 'idea'
                && isValidNotebookFollowUp(request.resource.data)
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'occasion', 'year', 'note', 'updatedAt'])));

      // A reservation leaves the notebook when it is released, on the server.
      allow delete: if isNotebookOwner(memberId) && resource.data.source == 'idea';
    }

    // « Mon budget » (récit 57): the budget of a whole occasion, no person, an occasion and its
    // year, at its one id. Adults only: the children do not have it.
    function isTotalBudget(b, budgetId) {
      return b.total == true
        && b.personId == null && b.personName == null
        && b.occasion != null && b.year != null
        && budgetId == 'total_' + b.occasion + '_' + string(b.year)
        && me().profile == 'adult';
    }

    // notebooks/{memberId}/budgets/{budgetId}: what the member means to spend for one person and
    // one occasion. The id is chosen by the app, one per person and occasion.
    match /notebooks/{memberId}/budgets/{budgetId} {
      allow read: if isNotebookOwner(memberId);

      allow create, update: if isNotebookOwner(memberId)
        && request.resource.data.keys().hasAll(['personId', 'personName', 'occasion', 'year', 'amount', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['personId', 'personName', 'occasion', 'year', 'amount', 'updatedAt', 'total'])
        && (isTotalBudget(request.resource.data, budgetId)
            || (request.resource.data.get('total', false) == false
                && (request.resource.data.personId == null || request.resource.data.personId is string)
                && request.resource.data.personName is string
                && request.resource.data.personName.size() > 0 && request.resource.data.personName.size() <= 40))
        && (request.resource.data.occasion == null
            || request.resource.data.occasion in ['christmas', 'birthday', 'birth', 'other'])
        && (request.resource.data.year == null
            || (request.resource.data.year is int && request.resource.data.year >= 2020 && request.resource.data.year <= 2100))
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.updatedAt == request.time;

      allow delete: if isNotebookOwner(memberId);
    }

    // --- Profile photos (PRD, récit 3 bis) -------------------------------------------------------

    // Who may change the photo of [memberId]: the member themself (a child with the app too), any
    // adult of the same household for a child (with or without the app), and the admin principal.
    function canChangePhoto(memberId) {
      return isMember()
        && (myMemberId() == memberId
            || isOwner()
            || (get(memberPath(memberId)).data.profile != 'adult'
                && get(memberPath(myMemberId())).data.profile == 'adult'
                && get(memberPath(myMemberId())).data.householdId == get(memberPath(memberId)).data.householdId));
    }

    // memberPhotos/{memberId} -> { jpeg, updatedAt }: a square JPEG of about 100 KB, made by the
    // app. Kept in Firestore rather than Storage: 13 small photos fit easily, they are served from
    // the offline cache like the rest, and these rules stay the only ones to check. Only the
    // family reads them. Removing the photo deletes the document.
    match /memberPhotos/{memberId} {
      allow read: if isMember();
      allow create, update: if canChangePhoto(memberId)
        && exists(memberPath(memberId))
        && request.resource.data.keys().hasOnly(['jpeg', 'updatedAt'])
        && request.resource.data.jpeg is bytes
        && request.resource.data.jpeg.size() > 0
        && request.resource.data.jpeg.size() <= 150000
        && request.resource.data.updatedAt == request.time;
      // Also when the member is removed, in the same batch, so no photo outlives its member.
      allow delete: if canChangePhoto(memberId) || (isMember() && !existsAfter(memberPath(memberId)));
    }

    // --- Fiche membre (PRD, récit 7 bis) ------------------------------------------------------------
    //
    // memberCards/{memberId} -> { shoes, tastes, hobbies, updatedBy, updatedAt }: the shoe size,
    // tastes and hobbies or passions of a member, free texts, blank when unknown. The whole family reads it, to
    // pick a present. Those who change the photo change the card. An empty card is deleted; the
    // functions delete it with its member (onMemberDeletedCard). The sizes and allergies of the
    // first version (top, bottom, allergies) are still accepted from an older app, never required.
    function isCardSize(v) {
      return v is string && v.size() <= 20;
    }

    function isCardText(v) {
      return v is string && v.size() <= 300;
    }

    match /memberCards/{memberId} {
      allow read: if isMember();
      allow create, update: if canChangePhoto(memberId)
        && exists(memberPath(memberId))
        && request.resource.data.keys().hasOnly(['tastes', 'hobbies', 'top', 'bottom', 'shoes', 'allergies', 'updatedBy', 'updatedAt'])
        && request.resource.data.keys().hasAll(['tastes', 'updatedBy', 'updatedAt'])
        && isCardText(request.resource.data.tastes)
        && isCardText(request.resource.data.get('hobbies', ''))
        && isCardSize(request.resource.data.get('top', ''))
        && isCardSize(request.resource.data.get('bottom', ''))
        && isCardSize(request.resource.data.get('shoes', ''))
        && isCardText(request.resource.data.get('allergies', ''))
        && request.resource.data.updatedBy == myMemberId()
        && request.resource.data.updatedAt == request.time;
      allow delete: if canChangePhoto(memberId);
    }

    // --- Carnet de recettes (récit 38) -------------------------------------------------------------
    //
    // recipes/{recipeId}: a family recipe, seen by every member. Ingredients and steps are kept as
    // texts, one per line, so the rules can bound them. Any member writes one in their own name;
    // the author, or the admin principal, edits and removes it. originMemberId says whose recipe
    // it is (a member of the family, or null with a free origin such as « Mamie Jeanne »).
    // A tag of a recipe: a short text, as parseTags() makes it in the app.
    function isRecipeTag(t) {
      return t is string && t.size() > 0 && t.size() <= 24;
    }

    // [before] is the recipe as stored, or null for a new one. A recipe whose origin member left the
    // family keeps that id, so it can still be changed (relecture #82, C2).
    function isValidRecipe(r, before) {
      return r.keys().hasAll(['title', 'origin', 'originMemberId', 'servings', 'ingredients', 'steps', 'tags',
                              'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && r.keys().hasOnly(['title', 'origin', 'originMemberId', 'servings', 'ingredients', 'steps', 'tags',
                             'authorId', 'authorName', 'createdAt', 'updatedAt', 'story', 'childInPhotos'])
        && r.title is string && r.title.size() > 0 && r.title.size() <= 80
        && r.origin is string && r.origin.size() <= 80
        && (r.originMemberId == null
            || (before != null && r.originMemberId == before.originMemberId)
            || (r.originMemberId is string && exists(memberPath(r.originMemberId))))
        && (r.servings == null || (r.servings is int && r.servings >= 1 && r.servings <= 50))
        && r.ingredients is string && r.ingredients.size() > 0 && r.ingredients.size() <= 3000
        && r.steps is string && r.steps.size() > 0 && r.steps.size() <= 6000
        && r.tags is list && r.tags.size() <= 6
        && (r.tags.size() < 1 || isRecipeTag(r.tags[0])) && (r.tags.size() < 2 || isRecipeTag(r.tags[1]))
        && (r.tags.size() < 3 || isRecipeTag(r.tags[2])) && (r.tags.size() < 4 || isRecipeTag(r.tags[3]))
        && (r.tags.size() < 5 || isRecipeTag(r.tags[4])) && (r.tags.size() < 6 || isRecipeTag(r.tags[5]))
        && r.authorName is string && r.authorName.size() > 0 && r.authorName.size() <= 40
        // Récit 47, both optional: its little story for the book, and « Un enfant est sur une des
        // photos », which makes the book follow carte EXPERT-2 for its photos.
        && (!('story' in r) || (r.story is string && r.story.size() <= 600))
        && (!('childInPhotos' in r) || r.childInPhotos is bool)
        && r.updatedAt == request.time;
    }

    function canManageRecipe(r) {
      return r.authorId == myMemberId() || isOwner();
    }

    match /recipes/{recipeId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidRecipe(request.resource.data, null)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && canManageRecipe(resource.data)
        && isValidRecipe(request.resource.data, resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isMember() && canManageRecipe(resource.data);
    }

    // recipes/{recipeId}/photos/{photoId} (récit 38, partie 2): the photos of the dish, shaped like
    // the photos of a trip (isValidAlbumPhoto) but with 3 places, 1 to 3. Whoever may change the
    // recipe adds and removes them; the files are in Storage at recipes/{recipeId}/{authorId}/.
    // Deleting the recipe deletes them on the server (onRecipeDeleted).
    function recipeOf(recipeId) {
      return get(/databases/$(database)/documents/recipes/$(recipeId)).data;
    }

    match /recipes/{recipeId}/photos/{photoId} {
      allow read: if isMember();
      allow create: if isMember()
        && canManageRecipe(recipeOf(recipeId))
        && isValidAlbumPhoto(request.resource.data, photoId)
        && request.resource.data.slot <= 3;
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId() || canManageRecipe(recipeOf(recipeId)));
    }

    // recipes/{recipeId}/comments/{commentId} (récit 38): every member reads and writes comments in
    // their own name, 1 to 500 characters, never edited. Its author, the author of the recipe or the
    // admin principal removes one. Deleting the recipe deletes them on the server.
    match /recipes/{recipeId}/comments/{commentId} {
      allow read: if isMember();
      allow create: if isMember()
        && exists(/databases/$(database)/documents/recipes/$(recipeId))
        && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt', 'mentionIds'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && hasCommentMentions(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time;
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId() || canManageRecipe(recipeOf(recipeId)));
    }

    // --- Trips (V3, récits 11 à 15) ----------------------------------------------------------------

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripOf(tripId) {
      return get(tripPath(tripId)).data;
    }

    function isClockTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // A list of member ids without duplicates.
    function isIdList(ids, min, max) {
      return ids is list && ids.size() >= min && ids.size() <= max && ids.toSet().size() == ids.size();
    }

    // A trip stores who takes part (participantIds) and who follows it (readerIds), so the rules of
    // its steps read one document. Participants always follow it (récit 12). Any member of the
    // family may be a participant, since several households often travel together (#114). Each
    // participant is not checked here: it would cost one read each, over the limit of 10 per write.
    function isValidTrip(t) {
      return t.keys().hasAll(['title', 'startDate', 'endDate', 'participantIds', 'readerIds', 'creatorId',
                              'creatorName', 'createdAt', 'updatedAt'])
        && t.keys().hasOnly(['title', 'startDate', 'endDate', 'participantIds', 'readerIds', 'creatorId',
                             'creatorName', 'createdAt', 'updatedAt', 'landscape'])
        // The landscape of the path (récit 81, DESIGN-53): optional, an older trip or app has none (dunes).
        && (!('landscape' in t) || t.landscape in ['dunes', 'mer', 'montagne', 'campagne', 'ville', 'neige'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 80
        && isDay(t.startDate) && isDay(t.endDate) && t.endDate >= t.startDate
        && isIdList(t.participantIds, 1, 13)
        && isIdList(t.readerIds, 1, 40)
        && t.readerIds.hasAll(t.participantIds)
        && t.creatorId in t.participantIds
        && t.creatorName is string && t.creatorName.size() > 0 && t.creatorName.size() <= 40
        && t.updatedAt == request.time;
    }

    function canManageTrip(t) {
      return t.creatorId == myMemberId() || isOwner();
    }

    // trips/{tripId}. Only an adult creates a trip (PRD rév. 131); a child takes part once an adult
    // adds them, says « bien arrivé » and fills the steps, but never edits the trip or its followers.
    // A member reads a trip only if they follow it: an unticked member sees nothing
    // of it, not even its steps (récit 12). The creator, or the admin principal, edits and deletes it.
    // Deleting a trip deletes its steps on the server.
    match /trips/{tripId} {
      allow read: if isMember() && myMemberId() in resource.data.readerIds;

      allow create: if isMember()
        && isValidTrip(request.resource.data)
        && request.resource.data.creatorId == myMemberId()
        && request.resource.data.creatorName == me().firstName
        && me().profile == 'adult'
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && canManageTrip(resource.data)
        && isValidTrip(request.resource.data)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isMember() && canManageTrip(resource.data);
    }

    // Shape of a step (récit 11). remindAt is the planned arrival plus 3 hours: the server reminds
    // the participants then, and clears it (récit 14). Once someone said « bien arrivé », there is
    // nothing left to remind.
    // The point of a step on the map of the trip (récit 87): optional, both numbers in range or both
    // null. Steps saved before the map, or by an older app, have neither.
    function isValidStepPosition(s) {
      return (!('lat' in s) && !('lng' in s))
        || (s.get('lat', null) == null && s.get('lng', null) == null)
        || (s.get('lat', null) is number && s.get('lng', null) is number
            && s.lat >= -90 && s.lat <= 90 && s.lng >= -180 && s.lng <= 180);
    }

    function isValidStep(s) {
      return s.keys().hasAll(['type', 'place', 'departDate', 'departTime', 'arriveDate', 'arriveTime', 'note',
                              'remindAt', 'arrivedAt', 'arrivedBy', 'arrivedByName', 'updatedAt'])
        && s.keys().hasOnly(['type', 'place', 'departDate', 'departTime', 'arriveDate', 'arriveTime', 'note',
                             'remindAt', 'arrivedAt', 'arrivedBy', 'arrivedByName', 'updatedAt', 'lat', 'lng'])
        && isValidStepPosition(s)
        && s.type in ['flight', 'train', 'car', 'lodging', 'activity']
        && s.place is string && s.place.size() > 0 && s.place.size() <= 120
        && isDay(s.departDate)
        && (s.departTime == null || isClockTime(s.departTime))
        && (s.arriveDate == null || (isDay(s.arriveDate) && s.arriveDate >= s.departDate))
        && (s.arriveTime == null || isClockTime(s.arriveTime))
        && (s.note == null || (s.note is string && s.note.size() <= 1000))
        && (s.remindAt == null || s.remindAt is timestamp)
        && s.updatedAt == request.time
        && ((s.arrivedAt == null && s.arrivedBy == null && s.arrivedByName == null)
            || (s.arrivedAt is timestamp && s.arrivedBy is string && s.arrivedByName is string && s.remindAt == null));
    }

    // « Bien arrivé » is signed with the caller's own name, at the time of the server.
    function isMyArrivalNow(s) {
      return s.arrivedAt == request.time && s.arrivedBy == myMemberId() && s.arrivedByName == me().firstName;
    }

    function isParticipantOf(tripId) {
      return myMemberId() in tripOf(tripId).participantIds;
    }

    // trips/{tripId}/steps/{stepId}. The followers of the trip read the steps; each participant adds,
    // edits and deletes them, and says « bien arrivé » (or takes it back) for everyone of the trip.
    match /trips/{tripId}/steps/{stepId} {
      allow read: if isMember() && myMemberId() in tripOf(tripId).readerIds;

      allow create: if isMember()
        && isParticipantOf(tripId)
        && isValidStep(request.resource.data)
        && (request.resource.data.arrivedAt == null || isMyArrivalNow(request.resource.data));

      allow update: if isMember()
        && isParticipantOf(tripId)
        && isValidStep(request.resource.data)
        && (request.resource.data.arrivedAt == null
            || isMyArrivalNow(request.resource.data)
            || (request.resource.data.arrivedAt == resource.data.arrivedAt
                && request.resource.data.arrivedBy == resource.data.arrivedBy
                && request.resource.data.arrivedByName == resource.data.arrivedByName));

      allow delete: if isMember() && (isParticipantOf(tripId) || isOwner());
    }

    // Shape of a line of the checklist (récit 13). The person in charge, if any, takes part in the
    // trip; their first name is kept so the line stays readable if they leave it.
    function isValidItem(i, tripId) {
      return i.keys().hasAll(['label', 'assigneeId', 'assigneeName', 'done', 'updatedAt'])
        && i.keys().hasOnly(['label', 'assigneeId', 'assigneeName', 'done', 'updatedAt'])
        && i.label is string && i.label.size() > 0 && i.label.size() <= 80
        && i.done is bool
        && i.updatedAt == request.time
        && ((i.assigneeId == null && i.assigneeName == null)
            || (i.assigneeId in tripOf(tripId).participantIds
                && i.assigneeName is string && i.assigneeName.size() > 0 && i.assigneeName.size() <= 40));
    }

    // trips/{tripId}/items/{itemId}. Only the participants read the checklist (récit 86: a follower
    // sees the steps, the photos and « bien arrivé », not what to bring) and add, tick, edit and
    // delete its lines. Deleting the trip deletes them on the server.
    match /trips/{tripId}/items/{itemId} {
      allow read: if isMember() && isParticipantOf(tripId);
      allow create, update: if isMember() && isParticipantOf(tripId) && isValidItem(request.resource.data, tripId);
      allow delete: if isMember() && (isParticipantOf(tripId) || isOwner());
    }

    // « Le mot de l'étape » (récit 88): trips/{tripId}/words/{stepId}, one short word per step, with
    // up to 4 photos of the trip album (their ids, in the order chosen) and the hearts of those
    // who follow the trip. A participant writes the word and signs it; only its author changes
    // the text and the photos or takes it back (the admin principal too, to take it back). Every
    // follower puts or takes back their own heart, and nothing else, with the `hearts` map
    // (member id: true). The word goes with its step and with its trip (server).
    function isValidWordPhotos(ids) {
      return ids is list && ids.size() <= 4 && ids.toSet().size() == ids.size();
    }

    function isWordText(text) {
      return text is string && text.size() > 0 && text.size() <= 280;
    }

    match /trips/{tripId}/words/{stepId} {
      allow read: if isMember() && myMemberId() in tripOf(tripId).readerIds;

      allow create: if isMember()
        && isParticipantOf(tripId)
        && exists(/databases/$(database)/documents/trips/$(tripId)/steps/$(stepId))
        && request.resource.data.keys().hasOnly(['text', 'photoIds', 'authorId', 'authorName', 'hearts', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['text', 'photoIds', 'authorId', 'authorName', 'hearts', 'createdAt', 'updatedAt'])
        && isWordText(request.resource.data.text)
        && isValidWordPhotos(request.resource.data.photoIds)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.hearts is map
        && request.resource.data.hearts.size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isMember() && (
        (resource.data.authorId == myMemberId()
          && isParticipantOf(tripId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'photoIds', 'updatedAt'])
          && isWordText(request.resource.data.text)
          && isValidWordPhotos(request.resource.data.photoIds)
          && request.resource.data.updatedAt == request.time)
        || (myMemberId() in tripOf(tripId).readerIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
          && request.resource.data.hearts.diff(resource.data.hearts).affectedKeys().hasOnly([myMemberId()])
          && (!(myMemberId() in request.resource.data.hearts) || request.resource.data.hearts[myMemberId()] == true)));

      allow delete: if isMember() && (resource.data.authorId == myMemberId() || isOwner());

      // The comments under a word: every follower reads and writes their own (1 to 500 characters,
      // with « @Prénom »), as under a good news. They go with the word.
      match /comments/{commentId} {
        allow read: if isMember() && myMemberId() in tripOf(tripId).readerIds;
        allow create: if isMember()
          && myMemberId() in tripOf(tripId).readerIds
          && exists(/databases/$(database)/documents/trips/$(tripId)/words/$(stepId))
          && request.resource.data.keys().hasAll(['text', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt', 'mentionIds'])
          && isCommentText(request.resource.data.text)
          && hasCommentMentions(request.resource.data)
          && request.resource.data.authorId == myMemberId()
          && request.resource.data.authorName == me().firstName
          && request.resource.data.createdAt == request.time;
        allow update: if isMember()
          && resource.data.authorId == myMemberId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'mentionIds'])
          && isCommentText(request.resource.data.text)
          && hasCommentMentions(request.resource.data)
          && request.resource.data.editedAt == request.time;
        allow delete: if isMember()
          && (resource.data.authorId == myMemberId()
              || isOwner()
              || get(/databases/$(database)/documents/trips/$(tripId)/words/$(stepId)).data.authorId == myMemberId());
      }

      // « Ne plus être prévenu » for the comments of a word, as for an event.
      match /commentMutes/{memberId} {
        allow read: if isMember() && memberId == myMemberId();
        allow create: if isMember()
          && memberId == myMemberId()
          && request.resource.data.keys().hasOnly(['mutedAt'])
          && request.resource.data.mutedAt == request.time;
        allow delete: if isMember() && memberId == myMemberId();
      }
    }

    // « Ma valise » (récit 62, module packingList): trips/{tripId}/bags/{memberId}, one private list
    // per participant, ticked by them or by one of their responsible adults (a child's bag), never
    // read by anyone else. `items` holds { label, done } maps, written whole each time. Deleting the
    // trip deletes the bags on the server.
    function isValidBag(b) {
      return b.keys().hasAll(['items', 'updatedAt', 'updatedBy'])
        && b.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && b.items is list && b.items.size() <= 80
        && b.updatedAt == request.time
        && b.updatedBy == myMemberId();
    }

    match /trips/{tripId}/bags/{memberId} {
      allow read, delete: if isMember() && canAnswerFor(memberId);
      allow create, update: if isMember()
        && canAnswerFor(memberId)
        && memberId in tripOf(tripId).participantIds
        && isValidBag(request.resource.data);
    }

    // Shape of a photo of the trip (récit 15). Each participant has 30 places, numbered 1 to 30:
    // the id of the document is the author and the place (« m1_7 »), so the rules cap the photos
    // per person without counting them. The files are in Storage (firebase/storage.rules), at
    // trips/{tripId}/{authorId}/{slot}.jpg and {slot}-thumb.jpg, sent before this document.
    // takenAt (récit 36, « Il y a N ans »): optional, when the photo was taken, read by the phone
    // from the EXIF of the file; never after now, never before 2001 (a clock never set).
    function isValidAlbumPhoto(p, photoId) {
      return p.keys().hasAll(['authorId', 'authorName', 'slot', 'createdAt'])
        && p.keys().hasOnly(['authorId', 'authorName', 'slot', 'createdAt', 'takenAt'])
        && (!('takenAt' in p) || (p.takenAt is timestamp
            // A day of margin: the clock of a phone may be a little ahead of the server's.
            && p.takenAt <= request.time + duration.value(1, 'd')
            && p.takenAt >= timestamp.date(2001, 1, 1)))
        && p.authorId == myMemberId()
        && p.authorName == me().firstName
        && p.slot is int && p.slot >= 1 && p.slot <= 30
        && photoId == p.authorId + '_' + string(p.slot)
        && p.createdAt == request.time;
    }

    // trips/{tripId}/photos/{photoId}. The followers see the photos; each participant adds their own,
    // and removes them. The creator of the trip, or the admin principal, can remove any photo. A
    // photo is never edited. Deleting the trip deletes the photos and their files on the server.
    match /trips/{tripId}/photos/{photoId} {
      allow read: if isMember() && myMemberId() in tripOf(tripId).readerIds;
      allow create: if isMember() && isParticipantOf(tripId) && isValidAlbumPhoto(request.resource.data, photoId);
      allow delete: if isMember()
        && (resource.data.authorId == myMemberId() || canManageTrip(tripOf(tripId)));
    }

    // --- Capsule temporelle (PRD, récit 39) -------------------------------------------------------
    //
    // capsules/{capsuleId}: a text and up to 3 photos for chosen members, sealed until openAt (one
    // month to five years ahead). Until then only the author reads it: the recipients do not even
    // see that it exists. On the day, the server alone copies recipientIds into openedFor and tells
    // them (functions/src/capsules.ts); they read it from then on. Never edited; the author removes
    // it while sealed. Photos in Storage at capsules/{authorId}/{capsuleId}/{n}.jpg, sent before.

    function isCapsuleDay(day) {
      return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function capsuleOpensAt(day) {
      let d = day.split('-');
      return timestamp.date(int(d[0]), int(d[1]), int(d[2]));
    }

    function isValidCapsule(c) {
      return c.keys().hasAll(['text', 'photoCount', 'recipientIds', 'openAt', 'openedFor', 'authorId', 'authorName', 'createdAt'])
        && c.keys().hasOnly(['text', 'photoCount', 'recipientIds', 'openAt', 'openedFor', 'authorId', 'authorName', 'createdAt'])
        && c.text is string && c.text.size() > 0 && c.text.size() <= 4000
        && c.photoCount is int && c.photoCount >= 0 && c.photoCount <= 3
        && isIdList(c.recipientIds, 1, 13)
        && isCapsuleDay(c.openAt)
        && capsuleOpensAt(c.openAt) >= request.time + duration.value(27, 'd')
        && capsuleOpensAt(c.openAt) <= request.time + duration.value(5 * 366, 'd')
        && c.openedFor == []
        && c.authorId == myMemberId()
        && c.authorName == me().firstName
        && c.createdAt == request.time;
    }

    match /capsules/{capsuleId} {
      allow read: if isMember()
        && (resource.data.authorId == myMemberId() || myMemberId() in resource.data.openedFor);
      allow create: if isMember() && isValidCapsule(request.resource.data);
      // Only while sealed (PRD rév. 187): once opened, it is a keepsake of its recipients.
      allow delete: if isMember() && resource.data.authorId == myMemberId() && resource.data.openedFor == [];
    }

    // capsuleLeftovers/{memberId}: written by the server when an author leaves the family, with how
    // many sealed capsules they left (PRD rév. 184). The admin principal reads it, without seeing
    // the capsules, and may only ask for their deletion; the server does it (functions/capsules.ts).
    match /capsuleLeftovers/{memberId} {
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleteAsked'])
        && request.resource.data.deleteAsked == true;
    }

    // --- Comptes (récit 16 bis) -------------------------------------------------------------------
    // The accounts of a trip (PRD rév. 193), a common brick: a book belongs to a container (a trip
    // today, an event of the planning since PRODUIT-57), at expenseBooks/{containerType}_{containerId}, out of
    // trips/ so the deletion of a trip never takes them by surprise. Only the adult participants of
    // the container see and change them: the readers of the trip and the children never do.
    // Amounts are whole euro cents. The sums of a split are checked by the app, which rules cannot
    // add up; the history of each expense is written by the server alone.

    function bookPath(bookId) {
      return /databases/$(database)/documents/expenseBooks/$(bookId);
    }

    // An event (PRODUIT-57): those who said « Je viens », and its author. « Peut-être » does not
    // share costs with the others.
    function comesToEvent(eventId, memberId) {
      return (exists(eventPath(eventId)) && get(eventPath(eventId)).data.authorId == memberId)
        || (exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(memberId))
            && get(/databases/$(database)/documents/events/$(eventId)/rsvps/$(memberId)).data.status == 'yes');
    }

    // Who takes part in a container: the participants of a trip, those who come to an event.
    function takesPart(containerType, containerId, memberId) {
      return (containerType == 'trip' && memberId in tripOf(containerId).participantIds)
        || (containerType == 'event' && comesToEvent(containerId, memberId));
    }

    // The creator of a book: the creator of the trip, the author of the event.
    function containerCreator(containerType, containerId) {
      return containerType == 'trip' ? tripOf(containerId).creatorId : get(eventPath(containerId)).data.authorId;
    }

    function canUseAccounts(containerType, containerId) {
      return isMember()
        && me().profile == 'adult'
        && containerType in ['trip', 'event']
        && takesPart(containerType, containerId, myMemberId());
    }

    function bookOf(bookId) {
      return get(bookPath(bookId)).data;
    }

    function canUseBook(book) {
      return canUseAccounts(book.containerType, book.containerId);
    }

    function isValidBook(b, bookId) {
      return b.keys().hasAll(['containerType', 'containerId', 'creatorId', 'shares', 'closed', 'createdAt', 'updatedAt'])
        && b.keys().hasOnly(['containerType', 'containerId', 'creatorId', 'shares', 'memberShares', 'closed', 'createdAt', 'updatedAt'])
        && b.containerType in ['trip', 'event']
        && b.containerId is string
        && bookId == b.containerType + '_' + b.containerId
        && b.shares is map && b.shares.size() >= 1 && b.shares.size() <= 13
        // The shares of each person, optional: a book opened before has none.
        && (!('memberShares' in b) || (b.memberShares is map && b.memberShares.size() <= 40))
        && b.closed is bool
        && b.updatedAt == request.time;
    }

    // Any adult participant opens the book; the creator of the trip keeps the right to correct
    // everything, to change the shares of each household and to close the accounts.
    match /expenseBooks/{bookId} {
      allow read: if isMember() && (resource == null || canUseBook(resource.data));
      allow create: if canUseAccounts(request.resource.data.containerType, request.resource.data.containerId)
        && isValidBook(request.resource.data, bookId)
        && request.resource.data.creatorId == containerCreator(request.resource.data.containerType, request.resource.data.containerId)
        && request.resource.data.closed == false
        && request.resource.data.createdAt == request.time;
      allow update: if canUseBook(resource.data)
        && (resource.data.creatorId == myMemberId() || isOwner())
        && isValidBook(request.resource.data, bookId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares', 'memberShares', 'closed', 'updatedAt'])
        && (resource.data.closed == false
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed', 'updatedAt']));
    }

    function isValidExpense(e, book) {
      return e.keys().hasAll(['title', 'amountCents', 'date', 'payerId', 'payerHouseholdId', 'category', 'mode',
          'householdIds', 'amounts', 'currency', 'originalCents', 'rate', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['title', 'amountCents', 'date', 'payerId', 'payerHouseholdId', 'category', 'mode',
          'householdIds', 'amounts', 'currency', 'originalCents', 'rate', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.title is string && e.title.size() >= 1 && e.title.size() <= 80
        && e.amountCents is int && e.amountCents > 0 && e.amountCents <= 10000000
        && isDay(e.date)
        && takesPart(book.containerType, book.containerId, e.payerId)
        && get(memberPath(e.payerId)).data.householdId == e.payerHouseholdId
        && e.category in ['lodging', 'transport', 'groceries', 'restaurant', 'activity', 'other']
        && e.mode in ['shares', 'equal', 'amounts']
        && e.householdIds is list && e.householdIds.size() >= 1 && e.householdIds.size() <= 13
        && book.shares.keys().hasAll(e.householdIds)
        && e.amounts is map
        && (e.mode == 'amounts' ? e.amounts.keys().hasOnly(e.householdIds) : e.amounts.size() == 0)
        && e.currency is string && e.currency.matches('^[A-Z]{3}$')
        && e.originalCents is int && e.originalCents > 0
        && e.rate is number && e.rate > 0
        && (e.currency != 'EUR' || (e.rate == 1 && e.originalCents == e.amountCents))
        && e.updatedAt == request.time;
    }

    // Each adult participant adds expenses, and changes or deletes their own; the creator of the
    // trip corrects any of them. Nothing changes once the accounts are closed.
    match /expenseBooks/{bookId}/expenses/{expenseId} {
      allow read: if canUseBook(bookOf(bookId));
      allow create: if canUseBook(bookOf(bookId))
        && bookOf(bookId).closed == false
        && isValidExpense(request.resource.data, bookOf(bookId))
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time;
      allow update: if canUseBook(bookOf(bookId))
        && bookOf(bookId).closed == false
        && (resource.data.authorId == myMemberId() || bookOf(bookId).creatorId == myMemberId())
        && isValidExpense(request.resource.data, bookOf(bookId))
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if canUseBook(bookOf(bookId))
        && bookOf(bookId).closed == false
        && (resource.data.authorId == myMemberId() || bookOf(bookId).creatorId == myMemberId());
    }

    // The history of an expense, written by the server on each change.
    match /expenseBooks/{bookId}/expenses/{expenseId}/history/{entryId} {
      allow read: if canUseBook(bookOf(bookId));
    }

    // « C'est remboursé », ticked by an adult of the household that received the money. It can be
    // taken back by who ticked it, until the accounts are closed. No reminder is ever sent.
    match /expenseBooks/{bookId}/settlements/{settlementId} {
      allow read: if canUseBook(bookOf(bookId));
      allow create: if canUseBook(bookOf(bookId))
        && bookOf(bookId).closed == false
        && request.resource.data.keys().hasAll(['fromHouseholdId', 'toHouseholdId', 'amountCents', 'confirmedBy', 'confirmedByName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['fromHouseholdId', 'toHouseholdId', 'amountCents', 'confirmedBy', 'confirmedByName', 'createdAt'])
        && request.resource.data.confirmedBy == myMemberId()
        && request.resource.data.confirmedByName == me().firstName
        && request.resource.data.toHouseholdId == me().householdId
        && request.resource.data.fromHouseholdId != request.resource.data.toHouseholdId
        && bookOf(bookId).shares.keys().hasAll([request.resource.data.fromHouseholdId, request.resource.data.toHouseholdId])
        && request.resource.data.amountCents is int && request.resource.data.amountCents > 0
        && request.resource.data.amountCents <= 10000000
        && request.resource.data.createdAt == request.time;
      allow delete: if canUseBook(bookOf(bookId))
        && bookOf(bookId).closed == false
        && resource.data.confirmedBy == myMemberId();
    }

    // --- Arbre généalogique (PRD, récit 40) ------------------------------------------------------
    //
    // The tree is drawn from the members and from kin/{kinId}, the relatives without an account
    // (great-grandparents, someone who passed away, or a living parent who is not in the app). They
    // receive nothing and are not members. kinLinks/{linkId} joins two people, members or kin: a
    // parent and their child, or two partners. The admin principal edits the whole tree; a chef de
    // famille edits the kin of their household and the links that touch it. Everyone reads it.
    // kinWords/{memberId}: the words a member chose for the people of the tree, for them alone.
    // Data model: docs/data-model.md.

    function kinPath(kinId) {
      return /databases/$(database)/documents/kin/$(kinId);
    }

    // The household a person of the tree belongs to: a member's, or the one a relative was added to.
    // getAfter for the kin, so a relative and their first link go in one batch.
    function personHousehold(personId) {
      return exists(memberPath(personId)) ? get(memberPath(personId)).data.householdId
        : (existsAfter(kinPath(personId)) ? getAfter(kinPath(personId)).data.householdId : null);
    }

    // A year (AAAA) or a day (AAAA-MM-JJ): an old date is often known only by its year.
    function isKinDate(d) {
      return d is string && d.matches('^[0-9]{4}(-[0-9]{2}-[0-9]{2})?$');
    }

    function isValidKin(k) {
      return k.keys().hasAll(['firstName', 'living', 'householdId', 'updatedBy', 'updatedAt'])
        && k.keys().hasOnly(['firstName', 'lastName', 'living', 'born', 'died', 'note', 'householdId', 'updatedBy', 'updatedAt'])
        && k.firstName is string && k.firstName.trim().size() > 0 && k.firstName.size() <= 40
        && (!('lastName' in k) || (k.lastName is string && k.lastName.size() <= 40))
        && k.living is bool
        && (!('born' in k) || isKinDate(k.born))
        && (!('died' in k) || (!k.living && isKinDate(k.died)))
        && (!('note' in k) || (k.note is string && k.note.size() <= 500))
        && k.householdId is string && exists(/databases/$(database)/documents/households/$(k.householdId))
        && k.updatedBy == myMemberId()
        && k.updatedAt == request.time;
    }

    match /kin/{kinId} {
      allow read: if isMember();
      allow create: if isMember() && isValidKin(request.resource.data)
        && managesHousehold(request.resource.data.householdId);
      allow update: if isMember() && isValidKin(request.resource.data)
        && managesHousehold(resource.data.householdId)
        && managesHousehold(request.resource.data.householdId);
      allow delete: if isMember() && managesHousehold(resource.data.householdId);
    }

    // kinPhotos/{kinId} -> { jpeg, updatedAt } (récit 79): the photo of a relative without an
    // account, made by the app like a profile photo (square, about 100 KB). Whoever may edit the
    // relative may change it; getAfter, so a new relative and their photo go in one batch. When
    // the relative leaves the tree, the server removes it (onKinDeleted).
    function canChangeKinPhoto(kinId) {
      return isMember() && existsAfter(kinPath(kinId))
        && managesHousehold(getAfter(kinPath(kinId)).data.householdId);
    }

    match /kinPhotos/{kinId} {
      allow read: if isMember();
      allow create, update: if canChangeKinPhoto(kinId)
        && request.resource.data.keys().hasOnly(['jpeg', 'updatedAt'])
        && request.resource.data.jpeg is bytes
        && request.resource.data.jpeg.size() > 0
        && request.resource.data.jpeg.size() <= 150000
        && request.resource.data.updatedAt == request.time;
      allow delete: if canChangeKinPhoto(kinId);
    }

    // One document per link, named after it, so the same link is never there twice. Two partners
    // are written in alphabetical order. A link never changes: it is removed, then made again.
    function isValidKinLink(l, linkId) {
      return l.keys().hasOnly(['kind', 'aId', 'bId', 'updatedBy', 'updatedAt'])
        && l.keys().hasAll(['kind', 'aId', 'bId', 'updatedBy', 'updatedAt'])
        && l.kind in ['parent', 'partner']
        && l.aId is string && l.aId.matches('^[A-Za-z0-9]{1,40}$')
        && l.bId is string && l.bId.matches('^[A-Za-z0-9]{1,40}$')
        && l.aId != l.bId
        && (l.kind == 'parent' || l.aId < l.bId)
        && linkId == l.kind + '_' + l.aId + '_' + l.bId
        && personHousehold(l.aId) != null
        && personHousehold(l.bId) != null
        && l.updatedBy == myMemberId()
        && l.updatedAt == request.time;
    }

    // Partners: the chef of either side (families mix: a son-in-law, a mother-in-law). A parent and
    // their child: only the chef of the child's household, since with shared custody this link is
    // sensitive and a chef never declares themselves parent of another household's child (PRD rév. 195).
    function managesLink(l) {
      return isOwner() || isChefOf(personHousehold(l.bId))
        || (l.kind == 'partner' && isChefOf(personHousehold(l.aId)));
    }

    match /kinLinks/{linkId} {
      allow read: if isMember();
      allow create: if isMember() && isValidKinLink(request.resource.data, linkId) && managesLink(request.resource.data);
      allow delete: if isMember() && managesLink(resource.data);
    }

    match /kinWords/{memberId} {
      allow read, delete: if isMember() && memberId == myMemberId();
      allow create, update: if isMember() && memberId == myMemberId()
        && request.resource.data.keys().hasOnly(['words', 'updatedAt'])
        && request.resource.data.words is map && request.resource.data.words.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    // --- App updates (lot 10) ---------------------------------------------------------------------

    // --- Question de la semaine (récit 37) ------------------------------------------------------
    //
    // The server publishes weeklyQuestions/{weekId} each Monday at 9 h and keeps its answerCount:
    // nothing writes a question from the app. An answer is weeklyQuestions/{weekId}/answers/{memberId},
    // written by that member only, children with the app included. Before revealAt (48 h after the
    // question), the answers of the others are read only once one has answered or passed, so
    // nobody copies (PRD rév. 148, avis [EXPERT] n° 8). Data model: docs/data-model.md.

    function weeklyQuestionPath(weekId) {
      return /databases/$(database)/documents/weeklyQuestions/$(weekId);
    }

    // The 5 fields, and an optional photoId. « Passer » is skipped with no text and no photo; an
    // answer is a short text, with at most one photo in Storage (weeklyQuestions/{weekId}/{memberId}/).
    function isValidAnswer(a, memberId) {
      return a.keys().hasAll(['memberId', 'memberName', 'text', 'skipped', 'updatedAt'])
        && a.keys().hasOnly(['memberId', 'memberName', 'text', 'skipped', 'updatedAt', 'photoId'])
        && (!('photoId' in a) || a.photoId == null
            || (!a.skipped && a.photoId is string && a.photoId.matches('^[A-Za-z0-9]{1,40}$')))
        && a.memberId == memberId
        && a.memberName == me().firstName
        && a.skipped is bool
        && (a.skipped ? a.text == null : (a.text is string && a.text.trim().size() > 0 && a.text.size() <= 500))
        && a.updatedAt == request.time;
    }

    match /weeklyQuestions/{weekId} {
      allow read: if isMember();
      allow write: if false;
    }

    match /weeklyQuestions/{weekId}/answers/{memberId} {
      allow read: if isMember()
        && (memberId == myMemberId()
            || exists(/databases/$(database)/documents/weeklyQuestions/$(weekId)/answers/$(myMemberId()))
            || request.time >= get(weeklyQuestionPath(weekId)).data.revealAt);

      allow create, update: if isMember()
        && memberId == myMemberId()
        && exists(weeklyQuestionPath(weekId))
        && isValidAnswer(request.resource.data, memberId);

      allow delete: if isMember() && memberId == myMemberId();
    }

    // usage/{memberId}/days/{day}: the time spent in the app, counted on the phone and sent once
    // a day (PRD, récit 1 nonies): the openings and the seconds per part of the app, never what
    // was read or written. Each member writes their own days only. The admin principal reads
    // everyone's, and the responsible adults of a child read that child's (carte EXPERT-5).
    // Nobody deletes: the TTL policy on expireAt (firestore.indexes.json) erases them after 13 months.
    function isUsageSeconds(seconds, key) {
      return !(key in seconds) || (seconds[key] is int && seconds[key] >= 0 && seconds[key] <= 86400);
    }

    function isValidUsageDay(d, day) {
      return d.keys().hasAll(['day', 'opens', 'seconds', 'expireAt'])
        && d.keys().hasOnly(['day', 'opens', 'seconds', 'expireAt'])
        && isDay(day) && d.day == day
        && d.opens is int && d.opens >= 0 && d.opens <= 500
        && d.seconds is map
        && d.seconds.keys().hasOnly(['home', 'planning', 'gifts', 'help', 'goodNews', 'weeklyQuestion', 'trips', 'family', 'other'])
        && isUsageSeconds(d.seconds, 'home') && isUsageSeconds(d.seconds, 'planning')
        && isUsageSeconds(d.seconds, 'gifts') && isUsageSeconds(d.seconds, 'help')
        && isUsageSeconds(d.seconds, 'goodNews') && isUsageSeconds(d.seconds, 'weeklyQuestion')
        && isUsageSeconds(d.seconds, 'trips') && isUsageSeconds(d.seconds, 'family')
        && isUsageSeconds(d.seconds, 'other')
        && d.expireAt is timestamp;
    }

    match /usage/{memberId}/days/{day} {
      allow read: if isMember()
        && (isOwner() || myMemberId() in get(memberPath(memberId)).data.parentIds);
      allow create, update: if isMember()
        && memberId == myMemberId()
        && isValidUsageDay(request.resource.data, day);
      allow delete: if false;
    }

    // --- « Rejoignez-moi » (PRD, récit 33) ---------------------------------------------------------
    //
    // joinMe/{shareId}: a place sent by a member to the members they ticked (nobody is ticked at
    // first, carte AVIS-13): their position of the moment, taken once when they touched the button,
    // or a place they chose. It is never changed; its author takes it back by deleting it, and
    // Firestore deletes it on its own 24 h later (TTL on expireAt). Only its author and its
    // recipients read it.

    function isValidJoinMe(d) {
      return d.keys().hasOnly(['authorId', 'authorName', 'recipientIds', 'name', 'address', 'lat', 'lng', 'note', 'createdAt', 'expireAt'])
        && d.keys().hasAll(['authorId', 'authorName', 'recipientIds', 'name', 'address', 'lat', 'lng', 'note', 'createdAt', 'expireAt'])
        && d.recipientIds is list && d.recipientIds.size() >= 1 && d.recipientIds.size() <= 30
        && !(d.authorId in d.recipientIds)
        && (d.name == null || (d.name is string && d.name.size() >= 1 && d.name.size() <= 60))
        && (d.address == null || (d.address is string && d.address.size() >= 1 && d.address.size() <= 200))
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && (d.note == null || (d.note is string && d.note.size() >= 1 && d.note.size() <= 200));
    }

    match /joinMe/{shareId} {
      allow read: if isMember()
        && (resource.data.authorId == myMemberId() || myMemberId() in resource.data.recipientIds);
      allow create: if isMember()
        && isValidJoinMe(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        // The phone writes « now + 24 h » from its own clock: a few hours of drift are let through.
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time + duration.value(22, 'h')
        && request.resource.data.expireAt < request.time + duration.value(26, 'h');
      allow update: if false;
      allow delete: if isMember() && resource.data.authorId == myMemberId();
    }

    // announcements/{announcementId}: Annonces de l'admin (PRD, récit 69). Only the admin principal
    // writes one, with the module « Annonces de l'admin » on:
    // a title of 1 to 60 characters, a message of 1 to 300, « Urgent », and the members ticked. Each
    // member ticked reads it (the notification opens it), the admin principal reads them all. Never
    // changed by the app: the server writes back `delivery` (sent, morning, refused).
    function announcementsOn() {
      let app = /databases/$(database)/documents/config/app;
      return exists(app) && get(app).data.get('features', {}).get('adminAnnouncements', false) == true;
    }

    match /announcements/{announcementId} {
      allow read: if isMember() && (isOwner() || myMemberId() in resource.data.recipientIds);
      allow create: if isOwner()
        && announcementsOn()
        && request.resource.data.keys().hasOnly(['title', 'text', 'urgent', 'recipientIds', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasAll(['title', 'text', 'urgent', 'recipientIds', 'authorId', 'authorName', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.urgent is bool
        && request.resource.data.recipientIds is list
        && request.resource.data.recipientIds.size() > 0 && request.resource.data.recipientIds.size() <= 60
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // feedback/{feedbackId}: « Une idée ? Un souci ? » (PRD, récit 6 sexies). Any member with the
    // app, a child included, sends an idea or a problem in their own name: a text of 1 to 1000
    // characters, and the context added by the phone (versions, model, the screen it came from).
    // Only its author and the admin principal read it. The admin principal gives it a state
    // (new, planned, done, declined) and an optional word of up to 300 characters, and nothing
    // else; the author or the admin principal deletes it. The server tells the admin principal of
    // each new one, and the author of each new state.
    function isFeedbackNote(note) {
      return note == null || (note is string && note.size() > 0 && note.size() <= 300);
    }

    match /feedback/{feedbackId} {
      allow read: if isMember() && (resource.data.authorId == myMemberId() || isOwner());
      allow create: if isMember()
        && request.resource.data.keys().hasAll(['kind', 'text', 'authorId', 'authorName', 'appVersion', 'android', 'device', 'screen', 'createdAt', 'status', 'note', 'statusAt'])
        && request.resource.data.keys().hasOnly(['kind', 'text', 'authorId', 'authorName', 'appVersion', 'android', 'device', 'screen', 'createdAt', 'status', 'note', 'statusAt', 'screenshot'])
        // The optional screenshot, sent to Storage just before, at the one place of this request.
        && (!('screenshot' in request.resource.data)
            || request.resource.data.screenshot == 'feedback/' + myMemberId() + '/' + feedbackId + '.jpg')
        && request.resource.data.kind in ['idea', 'problem']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40
        && request.resource.data.android is string && request.resource.data.android.size() <= 20
        && request.resource.data.device is string && request.resource.data.device.size() <= 80
        && request.resource.data.screen in ['family', 'help']
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && request.resource.data.note == null
        && request.resource.data.statusAt == null;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'statusAt'])
        && request.resource.data.status in ['new', 'planned', 'done', 'declined']
        && isFeedbackNote(request.resource.data.note)
        && request.resource.data.statusAt == request.time;
      allow delete: if isMember() && (resource.data.authorId == myMemberId() || isOwner());
    }

    // --- « Plantages » (récit 6 sexies, rév. 220) ----------------------------------------------------
    // crashReports/{reportId}: an error the app did not catch, kept on the phone and sent at the next
    // launch by the member who had it. Never a typed text, a photo or a list: the trace holds only
    // class names and lines, no message. Only the admin principal reads them, and « Marquer comme
    // réglé » removes the reports of one kind. The id is chosen on the phone: sent twice, it is
    // refused the second time, never counted twice.
    match /crashReports/{reportId} {
      allow read, delete: if isOwner();
      allow create: if isMember()
        && reportId.size() <= 64
        && request.resource.data.keys().hasAll(['memberId', 'appVersion', 'versionCode', 'android', 'device', 'screen', 'trace', 'signature', 'crashedAt', 'createdAt'])
        && request.resource.data.keys().hasOnly(['memberId', 'appVersion', 'versionCode', 'android', 'device', 'screen', 'trace', 'signature', 'crashedAt', 'createdAt'])
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.appVersion is string && request.resource.data.appVersion.size() <= 40
        && request.resource.data.versionCode is int
        && request.resource.data.android is string && request.resource.data.android.size() <= 20
        && request.resource.data.device is string && request.resource.data.device.size() <= 80
        && request.resource.data.screen is string && request.resource.data.screen.size() <= 80
        && request.resource.data.trace is string
        && request.resource.data.trace.size() > 0 && request.resource.data.trace.size() <= 8000
        && request.resource.data.signature is string && request.resource.data.signature.matches('^[0-9a-f]{16}$')
        && request.resource.data.crashedAt is timestamp && request.resource.data.crashedAt <= request.time
        && request.resource.data.createdAt == request.time;
    }

    // --- « Qui est-ce ? » (récit 43) -----------------------------------------------------------------
    // whoIsIt/{postId}: an old photo scanned by a member, file in Storage at
    // whoIsIt/{authorId}/{postId}/photo.jpg. Every member sees the photo and its hint; nobody sees
    // the answer before guessing. No score. Its author or the admin principal removes it; the
    // server then removes the answer, the guesses and the files (onWhoIsItDeleted).
    function isValidWhoIsIt(p) {
      return p.keys().hasAll(['authorId', 'authorName', 'hint', 'createdAt'])
        && p.keys().hasOnly(['authorId', 'authorName', 'hint', 'createdAt'])
        && p.hint is string && p.hint.size() <= 140
        && p.authorId == myMemberId()
        && p.authorName == me().firstName
        && p.createdAt == request.time;
    }

    function whoIsItOf(postId) {
      return get(/databases/$(database)/documents/whoIsIt/$(postId)).data;
    }

    // The post as it stands once the write is done: the app writes the post and its answer in one
    // batch, and get() would not see a post written in the same batch.
    function whoIsItAfter(postId) {
      return getAfter(/databases/$(database)/documents/whoIsIt/$(postId)).data;
    }

    function guessedWhoIsIt(postId) {
      return exists(/databases/$(database)/documents/whoIsIt/$(postId)/guesses/$(myMemberId()));
    }

    function isWhoIsItYear(y) {
      return y == null || (y is int && y >= 1850 && y <= 2100);
    }

    match /whoIsIt/{postId} {
      allow read: if isMember();
      allow create: if isMember() && postId.matches('^[A-Za-z0-9]{1,40}$') && isValidWhoIsIt(request.resource.data);
      allow delete: if isMember() && (resource.data.authorId == myMemberId() || isOwner());
    }

    // whoIsIt/{postId}/answer/main: who is on it and the year, written by the author with the
    // photo; [personId] points to someone of the tree (a member or a relative, récit 40). Read by
    // the author and by those who already guessed.
    match /whoIsIt/{postId}/answer/{docId} {
      allow read: if isMember() && (whoIsItOf(postId).authorId == myMemberId() || guessedWhoIsIt(postId));
      allow create, update: if isMember()
        && docId == 'main'
        && whoIsItAfter(postId).authorId == myMemberId()
        && request.resource.data.keys().hasAll(['who', 'year'])
        && request.resource.data.keys().hasOnly(['who', 'year', 'personId'])
        && request.resource.data.who is string
        && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 80
        && isWhoIsItYear(request.resource.data.year)
        && (!('personId' in request.resource.data.keys())
            || (request.resource.data.personId is string && request.resource.data.personId.size() <= 64));
      allow delete: if false;
    }

    // whoIsIt/{postId}/guesses/{memberId}: one guess per member, in their own name, never changed:
    // a name (or nothing, « Je ne sais pas ») and maybe a year. The author does not guess their
    // own photo. The guesses show once one has guessed, like the answer.
    match /whoIsIt/{postId}/guesses/{memberId} {
      allow read: if isMember() && (whoIsItOf(postId).authorId == myMemberId() || guessedWhoIsIt(postId));
      allow create: if isMember()
        && memberId == myMemberId()
        && whoIsItOf(postId).authorId != myMemberId()
        && request.resource.data.keys().hasAll(['who', 'year', 'name', 'createdAt'])
        && request.resource.data.keys().hasOnly(['who', 'year', 'name', 'createdAt'])
        && request.resource.data.who is string && request.resource.data.who.size() <= 80
        && isWhoIsItYear(request.resource.data.year)
        && request.resource.data.name == me().firstName
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // consumption/{day}: the use of the database each day, read from Cloud Monitoring by the
    // 30-minute task, from 8 h (récit 1 sexies). Only the admin principal sees it, in
    // Administration › Consommation; only the server writes it.
    match /consumption/{day} {
      allow read: if isOwner();
      allow write: if false;
    }

    // config/app: the latest version and the HTTPS link of its APK (docs/mise-a-jour.md), and
    // the module switches `features` (PRD rév. 120). config/family: { ownerMemberId }, the admin
    // principal. Every member reads them. The workflow « APK de publication » writes the version
    // fields of config/app and the workflow « Créer le premier admin » writes config/family,
    // neither bound by these rules. From the app, only the admin principal changes `features`,
    // and nothing else.
    // « Voir dans mon agenda » (récit 49): the secret token of my calendar link. Only I read it and
    // write it (a new one cuts the old link), never a child; the admin principal may cut it.
    match /calendarFeeds/{memberId} {
      allow read: if isMember() && memberId == myMemberId();
      allow create, update: if isMember() && memberId == myMemberId()
        && me().profile == 'adult'
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.matches('^[A-Za-z0-9_-]{43}$')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isMember() && (memberId == myMemberId() || isOwner());
    }

    match /config/{docId} {
      allow read: if isMember() && docId in ['app', 'family'];
      // The admin principal switches modules (features) and orders « À découvrir » (discoverOrder,
      // AVIS-19 partie 2: the module keys, 20 at most). `features` is never removed once there:
      // it may only be missing on a config/app that never had it. memoriesHidden (récit 36): the
      // souvenirs of « Il y a N ans » the admin principal took away for everyone, 300 at most.
      allow update: if docId == 'app'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['features', 'discoverOrder', 'memoriesHidden'])
        && (('features' in request.resource.data
                && request.resource.data.features is map && request.resource.data.features.size() <= 150)
            || (!('features' in request.resource.data) && !('features' in resource.data)))
        && (!('discoverOrder' in request.resource.data)
            || (request.resource.data.discoverOrder is list && request.resource.data.discoverOrder.size() <= 20))
        && (!('memoriesHidden' in request.resource.data)
            || (request.resource.data.memoriesHidden is list && request.resource.data.memoriesHidden.size() <= 300))
        && isOwner();
      // config/presentation: the Mode présentation (récit 48) was removed on 18/11 (PRODUIT-132).
      // The document may stay, ignored; nobody reads or writes it any more.
      allow delete: if false;
    }

    // Everything else is closed until a lot opens it explicitly.
  }
}
