rules_version = '2';

// Familia security rules. They apply the PRD "Droits par profil" on the server, so nothing changes
// even if someone bypasses the app. Each lot adds the rules for the collections it introduces.
// Data model: docs/data-model.md. Tests: firebase/tests (run against the Firestore emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Who is calling -------------------------------------------------------------------------

    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Emails are stored lower-case; Google may return any casing.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailIndexPath(email) {
      return /databases/$(database)/documents/memberEmails/$(email);
    }

    // A member is recognised by their verified Google address, which works before the first
    // sign-in has linked a Firebase UID to the member document.
    function isMember() {
      return hasVerifiedEmail() && exists(emailIndexPath(myEmail()));
    }

    function myMemberId() {
      return get(emailIndexPath(myEmail())).data.memberId;
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    // One of the (at most two) admins: Kévin and a second adult of his choice.
    function isAdmin() {
      return isMember() && get(memberPath(myMemberId())).data.isAdmin == true;
    }

    // Shape of a member document written by an admin. Profiles and parents follow docs/data-model.md.
    // colorIndex is optional: one of the 13 member colors of the app.
    function isValidMember(m) {
      return m.keys().hasAll(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid'])
        && m.keys().hasOnly(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid', 'colorIndex'])
        && (!('colorIndex' in m) || (m.colorIndex is int && m.colorIndex >= 0 && m.colorIndex <= 12))
        && m.firstName is string && m.firstName.size() > 0 && m.firstName.size() <= 40
        && (m.email == null || (m.email is string && m.email == m.email.lower()))
        && (m.birthDate == null || (m.birthDate is string && m.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && m.householdId is string && exists(/databases/$(database)/documents/households/$(m.householdId))
        && m.profile in ['adult', 'childWithApp', 'childWithoutApp']
        && m.isAdmin is bool && (!m.isAdmin || m.profile == 'adult')
        && m.parentIds is list
        && (m.profile == 'adult' || m.parentIds.size() > 0)
        && (m.profile != 'childWithoutApp' || m.email == null)
        && (m.profile == 'childWithoutApp' || m.email != null);
    }

    // The email index and the member document must always agree, in the same batched write.
    function emailIndexMatches(memberId, email) {
      return email == null || getAfter(emailIndexPath(email)).data.memberId == memberId;
    }

    // --- Collections ----------------------------------------------------------------------------

    // memberEmails/{email} -> { memberId }. Written by admins only, always in the same batch as
    // the member document it points to. Anyone signed in may read the entry for their own address,
    // so the app can tell "not in the family" apart from a permission error.
    match /memberEmails/{email} {
      allow read: if hasVerifiedEmail() && (email == myEmail() || isMember());
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['memberId'])
        && getAfter(memberPath(request.resource.data.memberId)).data.email == email;
      // Removing a member or changing their address must drop the old entry, otherwise the
      // person would keep access.
      allow delete: if isAdmin()
        && (!existsAfter(memberPath(resource.data.memberId))
            || getAfter(memberPath(resource.data.memberId)).data.email != email);
      allow update: if false;
    }

    // members/{memberId}. Readable by the whole family.
    match /members/{memberId} {
      allow read: if isMember();

      // First sign-in: a member links their own Firebase UID, once, and nothing else.
      allow update: if isMember()
        && myMemberId() == memberId
        && resource.data.get('uid', null) == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);

      // Admins add members. A new member has no linked account yet.
      allow create: if isAdmin()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == null
        && emailIndexMatches(memberId, request.resource.data.email);

      // Admins edit members, but never the linked account, and never their own admin flag:
      // an admin can name or remove the other admin, so the last admin can never be removed.
      allow update: if isAdmin()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && (memberId != myMemberId() || request.resource.data.isAdmin == resource.data.isAdmin)
        && emailIndexMatches(memberId, request.resource.data.email)
        && (resource.data.email == null || resource.data.email == request.resource.data.email
            || !existsAfter(emailIndexPath(resource.data.email)));

      // Admins remove members (a separation, for example), but not themselves, and the email
      // entry goes in the same batch.
      allow delete: if isAdmin()
        && memberId != myMemberId()
        && (resource.data.email == null || !existsAfter(emailIndexPath(resource.data.email)));
    }

    // households/{householdId}. Readable by the whole family, written by admins.
    match /households/{householdId} {
      allow read: if isMember();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow delete: if false; // A household is never deleted, its members may still point to it.
    }

    // --- Events (lot 4) ---------------------------------------------------------------------------

    function me() {
      return get(memberPath(myMemberId())).data;
    }

    // True when the caller is one of the responsible adults of the member [memberId] (a child).
    function isParentOf(memberId) {
      return memberId is string
        && exists(memberPath(memberId))
        && myMemberId() in get(memberPath(memberId)).data.parentIds;
    }

    // Shape of an event. Who it is for is stored on the event itself, so the rules never have to
    // read other events. authorName keeps the events of a removed member readable.
    function isValidEvent(e) {
      return e.keys().hasAll(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                              'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                             'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.title is string && e.title.size() > 0 && e.title.size() <= 80
        && e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (e.time == null || (e.time is string && e.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (e.place == null || (e.place is string && e.place.size() <= 120))
        && (e.note == null || (e.note is string && e.note.size() <= 1000))
        && e.authorName is string && e.authorName.size() > 0 && e.authorName.size() <= 40
        && e.updatedAt == request.time
        && ((e.targetType == 'self' && e.targetMemberId == e.authorId && e.householdId == null)
            || (e.targetType == 'child' && e.targetMemberId is string && e.householdId == null
                && exists(memberPath(e.targetMemberId))
                && get(memberPath(e.targetMemberId)).data.profile != 'adult')
            || (e.targetType == 'household' && e.targetMemberId == null && e.householdId is string
                && exists(/databases/$(database)/documents/households/$(e.householdId)))
            || (e.targetType == 'family' && e.targetMemberId == null && e.householdId == null));
    }

    // PRD "Droits par profil", creation: an admin for anyone; an adult for themselves, one of their
    // children, their household or the whole family; a child with the app for themselves only.
    function canTarget(e) {
      return isAdmin()
        || e.targetType == 'self'
        || (me().profile == 'adult'
            && (e.targetType == 'family'
                || (e.targetType == 'household' && e.householdId == me().householdId)
                || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // PRD "Droits par profil", edit and delete: an admin all events; anyone their own; an adult also
    // the events of their children (written by them or for them).
    function canManage(e) {
      return isAdmin()
        || e.authorId == myMemberId()
        || (me().profile == 'adult'
            && (isParentOf(e.authorId) || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // events/{eventId}. The whole family sees the planning.
    match /events/{eventId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidEvent(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && canTarget(request.resource.data);

      // The author and creation time never change; a new target must be one the editor may choose.
      allow update: if isMember()
        && canManage(resource.data)
        && isValidEvent(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && (canTarget(request.resource.data)
            || (request.resource.data.targetType == resource.data.targetType
                && request.resource.data.targetMemberId == resource.data.targetMemberId
                && request.resource.data.householdId == resource.data.householdId));

      allow delete: if isMember() && canManage(resource.data);
    }

    // --- Who is coming (lot 6) --------------------------------------------------------------------

    // PRD, récit 4: each member answers for themselves, and each adult also for their children.
    function canAnswerFor(memberId) {
      return memberId == myMemberId() || (me().profile == 'adult' && isParentOf(memberId));
    }

    function isValidRsvp(r) {
      return r.keys().hasAll(['status', 'answeredBy', 'updatedAt'])
        && r.keys().hasOnly(['status', 'answeredBy', 'updatedAt'])
        && r.status in ['yes', 'maybe', 'no']
        && r.answeredBy == myMemberId()
        && r.updatedAt == request.time;
    }

    // events/{eventId}/rsvps/{memberId}: one answer per member, written by that member or one of
    // their responsible adults. When an event is deleted, its answers are cleaned up on the server
    // (lot 8), which also warns the members who said they were coming.
    match /events/{eventId}/rsvps/{memberId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && exists(memberPath(memberId))
        && canAnswerFor(memberId)
        && isValidRsvp(request.resource.data);
      allow delete: if isMember() && canAnswerFor(memberId);
    }

    // Everything else is closed until a lot opens it explicitly.
  }
}
