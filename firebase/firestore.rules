rules_version = '2';

// Familia security rules. They apply the PRD "Droits par profil" on the server, so nothing changes
// even if someone bypasses the app. Each lot adds the rules for the collections it introduces.
// Data model: docs/data-model.md. Tests: firebase/tests (run against the Firestore emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Who is calling -------------------------------------------------------------------------

    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    // Emails are stored lower-case; Google may return any casing.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function emailIndexPath(email) {
      return /databases/$(database)/documents/memberEmails/$(email);
    }

    // A member is recognised by their verified Google address, which works before the first
    // sign-in has linked a Firebase UID to the member document.
    function isMember() {
      return hasVerifiedEmail() && exists(emailIndexPath(myEmail()));
    }

    function myMemberId() {
      return get(emailIndexPath(myEmail())).data.memberId;
    }

    function memberPath(memberId) {
      return /databases/$(database)/documents/members/$(memberId);
    }

    // The admin principal (PRD, récit 1 ter): named in config/family, which only the GitHub
    // workflow « Créer le premier admin » writes. Nobody can remove this role from the app.
    function familyConfigPath() {
      return /databases/$(database)/documents/config/family;
    }

    function ownerId() {
      return exists(familyConfigPath()) ? get(familyConfigPath()).data.ownerMemberId : null;
    }

    // Without config/family the get fails: nobody is admin principal, and an "isOwner() || …"
    // falls back on the other rights.
    function isOwner() {
      return isMember() && get(familyConfigPath()).data.ownerMemberId == myMemberId();
    }

    // A chef de famille (the member flag isAdmin) manages the members and events of their own
    // household only (PRD, « Périmètre d'un chef de famille », carte DEV-8).
    function isChefOf(householdId) {
      return isMember()
        && get(memberPath(myMemberId())).data.isAdmin == true
        && get(memberPath(myMemberId())).data.householdId == householdId;
    }

    // The admin principal, or a chef de famille of [householdId].
    function managesHousehold(householdId) {
      return isOwner() || isChefOf(householdId);
    }

    // A real calendar day as AAAA-MM-JJ (month 01 to 12, day 01 to 31).
    function isDay(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // A missing member makes getAfter fail, which refuses the write. One call per parent keeps
    // the rules under the limit of 10 document reads of a single write.
    function isAdultMember(memberId) {
      return memberId is string
        && getAfter(memberPath(memberId)).data.profile == 'adult';
    }

    // Responsible adults (lot 7 audit): an adult has none, since parentIds gives rights over the
    // events and answers of that member; a child has one to four, each an existing adult.
    function hasValidParents(m) {
      return m.parentIds is list
        && m.parentIds.size() <= 4
        && ((m.profile == 'adult' && m.parentIds.size() == 0) || (m.profile != 'adult' && m.parentIds.size() > 0))
        && (m.parentIds.size() < 1 || isAdultMember(m.parentIds[0]))
        && (m.parentIds.size() < 2 || isAdultMember(m.parentIds[1]))
        && (m.parentIds.size() < 3 || isAdultMember(m.parentIds[2]))
        && (m.parentIds.size() < 4 || isAdultMember(m.parentIds[3]));
    }

    // A chef de famille chooses responsible adults in the child's household only.
    function isAdultOf(memberId, householdId) {
      return isAdultMember(memberId) && getAfter(memberPath(memberId)).data.householdId == householdId;
    }

    function parentsInHousehold(m) {
      return (m.parentIds.size() < 1 || isAdultOf(m.parentIds[0], m.householdId))
        && (m.parentIds.size() < 2 || isAdultOf(m.parentIds[1], m.householdId))
        && (m.parentIds.size() < 3 || isAdultOf(m.parentIds[2], m.householdId))
        && (m.parentIds.size() < 4 || isAdultOf(m.parentIds[3], m.householdId));
    }

    // Shape of a member document written by the admin principal or a chef de famille. Profiles
    // and parents follow docs/data-model.md.
    // colorIndex is optional: one of the 13 member colors of the app.
    function isValidMember(m) {
      return m.keys().hasAll(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid'])
        && m.keys().hasOnly(['firstName', 'email', 'birthDate', 'householdId', 'profile', 'isAdmin', 'parentIds', 'uid', 'colorIndex'])
        && (!('colorIndex' in m) || (m.colorIndex is int && m.colorIndex >= 0 && m.colorIndex <= 12))
        && m.firstName is string && m.firstName.size() > 0 && m.firstName.size() <= 40
        && (m.email == null || (m.email is string && m.email == m.email.lower()))
        && (m.birthDate == null || isDay(m.birthDate))
        && m.householdId is string && exists(/databases/$(database)/documents/households/$(m.householdId))
        && m.profile in ['adult', 'childWithApp', 'childWithoutApp']
        && m.isAdmin is bool && (!m.isAdmin || m.profile == 'adult')
        && hasValidParents(m)
        && (m.profile != 'childWithoutApp' || m.email == null)
        && (m.profile == 'childWithoutApp' || m.email != null);
    }

    // The email index and the member document must always agree, in the same batched write.
    function emailIndexMatches(memberId, email) {
      return email == null || getAfter(emailIndexPath(email)).data.memberId == memberId;
    }

    // --- Collections ----------------------------------------------------------------------------

    // memberEmails/{email} -> { memberId }. Written by whoever manages the member's household,
    // always in the same batch as
    // the member document it points to. Anyone signed in may read the entry for their own address,
    // so the app can tell "not in the family" apart from a permission error.
    match /memberEmails/{email} {
      allow read: if hasVerifiedEmail() && (email == myEmail() || isMember());
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['memberId'])
        && getAfter(memberPath(request.resource.data.memberId)).data.email == email
        && managesHousehold(getAfter(memberPath(request.resource.data.memberId)).data.householdId);
      // Removing a member or changing their address must drop the old entry, otherwise the
      // person would keep access.
      allow delete: if isMember()
        && (!existsAfter(memberPath(resource.data.memberId))
            || getAfter(memberPath(resource.data.memberId)).data.email != email)
        && (isOwner()
            || (exists(memberPath(resource.data.memberId))
                && isChefOf(get(memberPath(resource.data.memberId)).data.householdId)));
      allow update: if false;
    }

    // members/{memberId}. Readable by the whole family.
    match /members/{memberId} {
      allow read: if isMember();

      // First sign-in: a member links their own Firebase UID, once, and nothing else.
      allow update: if isMember()
        && myMemberId() == memberId
        && resource.data.get('uid', null) == null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid']);

      // The admin principal adds anyone; a chef de famille adds members to their own household,
      // never another chef, with responsible adults of that household. No linked account yet.
      allow create: if isMember()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == null
        && emailIndexMatches(memberId, request.resource.data.email)
        && (isOwner()
            || (isChefOf(request.resource.data.householdId)
                && request.resource.data.isAdmin == false
                && parentsInHousehold(request.resource.data)));

      // The admin principal edits anyone and names the chefs. A chef de famille edits the members
      // of their household, never the chef flag, never the admin principal, and keeps the member
      // in that household. Nobody changes the linked account.
      allow update: if isMember()
        && isValidMember(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && emailIndexMatches(memberId, request.resource.data.email)
        && (resource.data.email == null || resource.data.email == request.resource.data.email
            || !existsAfter(emailIndexPath(resource.data.email)))
        && (isOwner()
            || (isChefOf(resource.data.householdId)
                && request.resource.data.householdId == resource.data.householdId
                && request.resource.data.isAdmin == resource.data.isAdmin
                && memberId != ownerId()
                // Changing another chef's address would hand their access to someone else.
                && (resource.data.isAdmin == false
                    || memberId == myMemberId()
                    || request.resource.data.email == resource.data.email)
                && (request.resource.data.parentIds == resource.data.parentIds
                    || parentsInHousehold(request.resource.data))));

      // The admin principal or a chef of the household removes a member (a separation, for
      // example), never themselves; a chef never removes another chef or the admin principal.
      // The email entry goes in the same batch.
      allow delete: if isMember()
        && memberId != myMemberId()
        && (resource.data.email == null || !existsAfter(emailIndexPath(resource.data.email)))
        && (isOwner()
            || (isChefOf(resource.data.householdId)
                && resource.data.isAdmin == false
                && memberId != ownerId()));
    }

    function isValidHousehold(h) {
      return h.keys().hasOnly(['name'])
        && h.name is string
        && h.name.size() > 0 && h.name.size() <= 40;
    }

    // households/{householdId}. Readable by the whole family. The admin principal creates and
    // deletes them (the app only offers to delete an empty one); a chef renames their own.
    match /households/{householdId} {
      allow read: if isMember();
      allow create: if isOwner() && isValidHousehold(request.resource.data);
      allow update: if managesHousehold(householdId) && isValidHousehold(request.resource.data);
      allow delete: if isOwner();
    }

    // --- Events (lot 4) ---------------------------------------------------------------------------

    function me() {
      return get(memberPath(myMemberId())).data;
    }

    // True when the caller is one of the responsible adults of the member [memberId] (a child).
    function isParentOf(memberId) {
      return memberId is string
        && exists(memberPath(memberId))
        && myMemberId() in get(memberPath(memberId)).data.parentIds;
    }

    // Shape of an event. Who it is for is stored on the event itself, so the rules never have to
    // read other events. authorName keeps the events of a removed member readable.
    function isValidEvent(e) {
      return e.keys().hasAll(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                              'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.keys().hasOnly(['title', 'date', 'time', 'place', 'note', 'targetType', 'targetMemberId',
                             'householdId', 'authorId', 'authorName', 'createdAt', 'updatedAt'])
        && e.title is string && e.title.size() > 0 && e.title.size() <= 80
        && isDay(e.date)
        && (e.time == null || (e.time is string && e.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (e.place == null || (e.place is string && e.place.size() <= 120))
        && (e.note == null || (e.note is string && e.note.size() <= 1000))
        && e.authorName is string && e.authorName.size() > 0 && e.authorName.size() <= 40
        && e.updatedAt == request.time
        && ((e.targetType == 'self' && e.targetMemberId == e.authorId && e.householdId == null)
            || (e.targetType == 'child' && e.targetMemberId is string && e.householdId == null
                && exists(memberPath(e.targetMemberId))
                && get(memberPath(e.targetMemberId)).data.profile != 'adult')
            || (e.targetType == 'household' && e.targetMemberId == null && e.householdId is string
                && exists(/databases/$(database)/documents/households/$(e.householdId)))
            || (e.targetType == 'family' && e.targetMemberId == null && e.householdId == null));
    }

    // PRD "Droits par profil", creation: the admin principal for anyone; an adult (chefs included)
    // for themselves, one of their children, their household or the whole family; a child with the
    // app for themselves only.
    function canTarget(e) {
      return isOwner()
        || e.targetType == 'self'
        || (me().profile == 'adult'
            && (e.targetType == 'family'
                || (e.targetType == 'household' && e.householdId == me().householdId)
                || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // PRD "Droits par profil" and récit 5, edit and delete: the admin principal all events; anyone
    // their own; a chef de famille those written by a member of their household; an adult also the
    // events of their children (written by them or for them).
    function canManage(e) {
      return isOwner()
        || e.authorId == myMemberId()
        || (exists(memberPath(e.authorId)) && isChefOf(get(memberPath(e.authorId)).data.householdId))
        || (me().profile == 'adult'
            && (isParentOf(e.authorId) || (e.targetType == 'child' && isParentOf(e.targetMemberId))));
    }

    // events/{eventId}. The whole family sees the planning.
    match /events/{eventId} {
      allow read: if isMember();

      allow create: if isMember()
        && isValidEvent(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && canTarget(request.resource.data);

      // The author and creation time never change; a new target must be one the editor may choose.
      allow update: if isMember()
        && canManage(resource.data)
        && isValidEvent(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && (canTarget(request.resource.data)
            || (request.resource.data.targetType == resource.data.targetType
                && request.resource.data.targetMemberId == resource.data.targetMemberId
                && request.resource.data.householdId == resource.data.householdId));

      allow delete: if isMember() && canManage(resource.data);
    }

    // --- Who is coming (lot 6) --------------------------------------------------------------------

    // PRD, récit 4: each member answers for themselves, and each adult also for their children.
    function canAnswerFor(memberId) {
      return memberId == myMemberId() || (me().profile == 'adult' && isParentOf(memberId));
    }

    function isValidRsvp(r) {
      return r.keys().hasAll(['status', 'answeredBy', 'updatedAt'])
        && r.keys().hasOnly(['status', 'answeredBy', 'updatedAt'])
        && r.status in ['yes', 'maybe', 'no']
        && r.answeredBy == myMemberId()
        && r.updatedAt == request.time;
    }

    // events/{eventId}/rsvps/{memberId}: one answer per member, written by that member or one of
    // their responsible adults. When an event is deleted, its answers are cleaned up on the server
    // (lot 8), which also warns the members who said they were coming.
    match /events/{eventId}/rsvps/{memberId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && exists(memberPath(memberId))
        && canAnswerFor(memberId)
        && isValidRsvp(request.resource.data);
      allow delete: if isMember() && canAnswerFor(memberId);
    }

    // The answers of all events at once, for the counters of the planning (collectionGroup query).
    // Read only: writes go through events/{eventId}/rsvps/{memberId} above.
    match /{path=**}/rsvps/{memberId} {
      allow read: if isMember();
    }

    // --- Notifications (lot 8) --------------------------------------------------------------------

    // members/{memberId}/devices/{token}: the phones of a member, one document per notification
    // token. Only that member reads or writes them. The Cloud Functions read them with their own
    // server access, and delete the token of an uninstalled app.
    match /members/{memberId}/devices/{token} {
      allow read, delete: if isMember() && myMemberId() == memberId;
      allow create, update: if isMember()
        && myMemberId() == memberId
        && token.size() <= 4096
        && request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
    }

    // members/{memberId}/settings/notifications: the member's own choices (PRD, récit 6 bis: the
    // reminder the evening before can be turned off). Nobody else reads or changes them.
    match /members/{memberId}/settings/{settingId} {
      allow read: if isMember() && myMemberId() == memberId;
      allow create, update: if isMember()
        && myMemberId() == memberId
        && settingId == 'notifications'
        && request.resource.data.keys().hasOnly(['dayBeforeReminder'])
        && request.resource.data.dayBeforeReminder is bool;
    }

    // --- Listes et cadeaux (V2) -------------------------------------------------------------------
    //
    // PRD, récits 7 à 10 bis. The surprise is kept by the server, not by the app: the beneficiary
    // of a list never reads a surprise list made for them, the items others add to their own list,
    // the reservations or the shares of a joint gift, until the list is revealed the day after the
    // occasion (`revealed`, written only by the Cloud Function). Data model: docs/data-model.md.

    function giftListPath(listId) {
      return /databases/$(database)/documents/giftLists/$(listId);
    }

    // The caller keeps the lists of [memberId]: their own, or those of a child without the app
    // they are a responsible adult of (PRD, récit 7).
    function keepsListsOf(memberId) {
      return memberId == myMemberId()
        || (exists(memberPath(memberId))
            && get(memberPath(memberId)).data.profile == 'childWithoutApp'
            && myMemberId() in get(memberPath(memberId)).data.parentIds);
    }

    // Who sees a list. « Mes envies » is open to the whole family; any other list to the members
    // checked in viewerIds. The beneficiary is never among the viewers of a surprise list, and
    // only reads it once it is revealed. Written as a plain OR so the app's queries can be proven.
    function canSeeList(l) {
      return l.kind == 'wishes'
        || myMemberId() in l.viewerIds
        || (l.beneficiaryId == myMemberId() && l.revealed == true);
    }

    // The beneficiary does not see what the others do on their list before it is revealed.
    function isKeptFromMe(l) {
      return l.beneficiaryId == myMemberId() && l.revealed != true;
    }

    // The creator manages a list; the keeper of the beneficiary manages their own list and wishes.
    function canManageList(l) {
      return l.creatorId == myMemberId() || (l.kind != 'surprise' && keepsListsOf(l.beneficiaryId));
    }

    function isValidGiftList(l) {
      return l.keys().hasAll(['kind', 'title', 'occasion', 'date', 'beneficiaryId', 'viewerIds',
                              'creatorId', 'creatorName', 'revealed', 'createdAt', 'updatedAt'])
        && l.keys().hasOnly(['kind', 'title', 'occasion', 'date', 'beneficiaryId', 'viewerIds',
                             'creatorId', 'creatorName', 'revealed', 'createdAt', 'updatedAt'])
        && l.kind in ['wishes', 'own', 'surprise']
        && l.title is string && l.title.size() > 0 && l.title.size() <= 60
        && l.beneficiaryId is string && exists(memberPath(l.beneficiaryId))
        && l.viewerIds is list && l.viewerIds.size() <= 40
        && l.creatorName is string && l.creatorName.size() > 0 && l.creatorName.size() <= 40
        && l.revealed is bool
        && l.updatedAt == request.time
        && ((l.kind == 'wishes' && l.occasion == null && l.date == null && l.viewerIds.size() == 0)
            || (l.kind != 'wishes'
                && l.occasion in ['christmas', 'birthday', 'birth', 'other']
                && isDay(l.date)
                && myMemberId() in l.viewerIds
                && (l.kind != 'own'
                    || (l.beneficiaryId in l.viewerIds
                        // The responsible adults of a child always see the child's own list.
                        && l.viewerIds.hasAll(get(memberPath(l.beneficiaryId)).data.parentIds)))
                && (l.kind != 'surprise'
                    || (!(l.beneficiaryId in l.viewerIds) && l.beneficiaryId != myMemberId()))));
    }

    // giftLists/{listId}. « Mes envies » of a member has the id wishes-{memberId}, so there is one.
    match /giftLists/{listId} {
      allow read: if isMember() && canSeeList(resource.data);

      allow create: if isMember()
        && isValidGiftList(request.resource.data)
        && request.resource.data.creatorId == myMemberId()
        && request.resource.data.creatorName == me().firstName
        && request.resource.data.revealed == false
        && request.resource.data.createdAt == request.time
        && (request.resource.data.kind == 'surprise'
            || (keepsListsOf(request.resource.data.beneficiaryId)
                && (request.resource.data.kind != 'wishes'
                    || listId == 'wishes-' + request.resource.data.beneficiaryId)));

      // The kind, the beneficiary, the creator and the reveal never change from the app, and a
      // revealed list is archived: read-only.
      allow update: if isMember()
        && resource.data.revealed == false
        && canManageList(resource.data)
        && isValidGiftList(request.resource.data)
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.beneficiaryId == resource.data.beneficiaryId
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.revealed == resource.data.revealed
        && request.resource.data.createdAt == resource.data.createdAt;

      // « Mes envies » is permanent. Items, reservations and shares are removed on the server.
      allow delete: if isMember() && resource.data.kind != 'wishes' && canManageList(resource.data);
    }

    function isValidGiftItem(i) {
      return i.keys().hasAll(['title', 'url', 'price', 'note', 'authorId', 'authorName',
                              'visibleToBeneficiary', 'createdAt', 'updatedAt'])
        && i.keys().hasOnly(['title', 'url', 'price', 'note', 'authorId', 'authorName',
                             'visibleToBeneficiary', 'createdAt', 'updatedAt', 'imageUrl'])
        && i.title is string && i.title.size() > 0 && i.title.size() <= 80
        && (i.url == null || (i.url is string && i.url.size() <= 500 && i.url.matches('^https?://.+')))
        && (i.price == null || (i.price is number && i.price >= 0 && i.price <= 100000))
        && (i.note == null || (i.note is string && i.note.size() <= 500))
        // Optional picture of a shared link (carte PRODUIT-34), never a file stored by Familia.
        && (!('imageUrl' in i) || i.imageUrl == null
            || (i.imageUrl is string && i.imageUrl.size() <= 1000 && i.imageUrl.matches('^https://.+')))
        && i.authorName is string && i.authorName.size() > 0 && i.authorName.size() <= 40
        && i.visibleToBeneficiary is bool
        && i.updatedAt == request.time;
    }

    // giftLists/{listId}/items/{itemId}. An item added by someone other than the keeper of the
    // beneficiary is a surprise idea: visibleToBeneficiary is false, and the beneficiary never
    // reads it before the reveal (PRD, récit 8).
    match /giftLists/{listId}/items/{itemId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      function claimPath() {
        return /databases/$(database)/documents/giftLists/$(listId)/claims/$(itemId);
      }

      allow read: if isMember()
        && canSeeList(list())
        && (!isKeptFromMe(list()) || resource.data.visibleToBeneficiary == true);

      allow create: if isMember()
        && exists(giftListPath(listId))
        && canSeeList(list())
        && list().revealed == false
        && isValidGiftItem(request.resource.data)
        && request.resource.data.authorId == myMemberId()
        && request.resource.data.authorName == me().firstName
        && request.resource.data.createdAt == request.time
        && request.resource.data.visibleToBeneficiary
             == (list().kind != 'surprise' && keepsListsOf(list().beneficiaryId));

      // The author edits or removes their item until it is reserved. The beneficiary's side may
      // always do it: refusing would tell them that the item is reserved. The Cloud Function then
      // warns whoever had reserved it.
      allow update: if isMember()
        && resource.data.authorId == myMemberId()
        && list().revealed == false
        && (resource.data.visibleToBeneficiary == true || !exists(claimPath()))
        && isValidGiftItem(request.resource.data)
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.visibleToBeneficiary == resource.data.visibleToBeneficiary
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isMember()
        && resource.data.authorId == myMemberId()
        && (resource.data.visibleToBeneficiary == true || !exists(claimPath()));
    }

    // giftLists/{listId}/claims/{itemId}: the reservation of an item, one at most (PRD, récit 9).
    // « Je le prends » (solo) or a joint gift (shared) opened by its responsible, the holder.
    // A child with the app reserves alone, never a joint gift (carte PRODUIT-19).
    match /giftLists/{listId}/claims/{itemId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      allow read: if isMember() && canSeeList(list()) && !isKeptFromMe(list());

      allow create: if isMember()
        && exists(giftListPath(listId))
        && canSeeList(list())
        && list().revealed == false
        && list().beneficiaryId != myMemberId()
        && exists(/databases/$(database)/documents/giftLists/$(listId)/items/$(itemId))
        && request.resource.data.keys().hasAll(['type', 'holderId', 'holderName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'holderId', 'holderName', 'createdAt'])
        && request.resource.data.type in ['solo', 'shared']
        && request.resource.data.holderId == myMemberId()
        && request.resource.data.holderName == me().firstName
        && request.resource.data.createdAt == request.time
        && (request.resource.data.type == 'solo' || me().profile == 'adult');

      allow update: if false;

      // The holder releases the item; the shares of a joint gift are removed on the server.
      allow delete: if isMember() && resource.data.holderId == myMemberId();
    }

    function isValidShare(s) {
      return s.keys().hasAll(['amount', 'memberName', 'received', 'updatedAt'])
        && s.keys().hasOnly(['amount', 'memberName', 'received', 'updatedAt'])
        && s.amount is number && s.amount > 0 && s.amount <= 10000
        && s.memberName is string && s.memberName.size() > 0 && s.memberName.size() <= 40
        && s.received is bool
        && s.updatedAt == request.time;
    }

    // giftLists/{listId}/claims/{itemId}/shares/{memberId}: a part of a joint gift. Each adult
    // declares their own; the responsible (the holder) marks it received. No real payment.
    match /giftLists/{listId}/claims/{itemId}/shares/{memberId} {
      function list() {
        return get(giftListPath(listId)).data;
      }

      function claim() {
        return get(/databases/$(database)/documents/giftLists/$(listId)/claims/$(itemId)).data;
      }

      allow read: if isMember() && canSeeList(list()) && !isKeptFromMe(list());

      allow create: if isMember()
        && memberId == myMemberId()
        && me().profile == 'adult'
        && canSeeList(list())
        && list().revealed == false
        && list().beneficiaryId != myMemberId()
        && claim().type == 'shared'
        && isValidShare(request.resource.data)
        && request.resource.data.memberName == me().firstName
        && request.resource.data.received == false;

      // The member changes their amount; the responsible marks the share received or not.
      allow update: if isMember()
        && list().revealed == false
        && isValidShare(request.resource.data)
        && ((memberId == myMemberId()
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'updatedAt']))
            || (claim().holderId == myMemberId()
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['received', 'updatedAt'])));

      allow delete: if isMember() && (memberId == myMemberId() || claim().holderId == myMemberId());
    }

    // --- Trips (V3, récits 11, 12 et 14) ----------------------------------------------------------

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function tripOf(tripId) {
      return get(tripPath(tripId)).data;
    }

    function isClockTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // A list of member ids without duplicates.
    function isIdList(ids, min, max) {
      return ids is list && ids.size() >= min && ids.size() <= max && ids.toSet().size() == ids.size();
    }

    // A trip stores who takes part (participantIds) and who follows it (readerIds), so the rules of
    // its steps read one document. Participants always follow it (récit 12). An adult adds only the
    // children of their household (récit 11): the app checks it, since checking each participant
    // here would cost one read each, over the limit of 10 per write.
    function isValidTrip(t) {
      return t.keys().hasAll(['title', 'startDate', 'endDate', 'participantIds', 'readerIds', 'creatorId',
                              'creatorName', 'createdAt', 'updatedAt'])
        && t.keys().hasOnly(['title', 'startDate', 'endDate', 'participantIds', 'readerIds', 'creatorId',
                             'creatorName', 'createdAt', 'updatedAt'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 80
        && isDay(t.startDate) && isDay(t.endDate) && t.endDate >= t.startDate
        && isIdList(t.participantIds, 1, 13)
        && isIdList(t.readerIds, 1, 40)
        && t.readerIds.hasAll(t.participantIds)
        && t.creatorId in t.participantIds
        && t.creatorName is string && t.creatorName.size() > 0 && t.creatorName.size() <= 40
        && t.updatedAt == request.time;
    }

    function canManageTrip(t) {
      return t.creatorId == myMemberId() || isOwner();
    }

    // trips/{tripId}. A member reads a trip only if they follow it: an unticked member sees nothing
    // of it, not even its steps (récit 12). The creator, or the admin principal, edits and deletes it.
    // Deleting a trip deletes its steps on the server.
    match /trips/{tripId} {
      allow read: if isMember() && myMemberId() in resource.data.readerIds;

      allow create: if isMember()
        && isValidTrip(request.resource.data)
        && request.resource.data.creatorId == myMemberId()
        && request.resource.data.creatorName == me().firstName
        && request.resource.data.createdAt == request.time;

      allow update: if isMember()
        && canManageTrip(resource.data)
        && isValidTrip(request.resource.data)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isMember() && canManageTrip(resource.data);
    }

    // Shape of a step (récit 11). remindAt is the planned arrival plus 3 hours: the server reminds
    // the participants then, and clears it (récit 14). Once someone said « bien arrivé », there is
    // nothing left to remind.
    function isValidStep(s) {
      return s.keys().hasAll(['type', 'place', 'departDate', 'departTime', 'arriveDate', 'arriveTime', 'note',
                              'remindAt', 'arrivedAt', 'arrivedBy', 'arrivedByName', 'updatedAt'])
        && s.keys().hasOnly(['type', 'place', 'departDate', 'departTime', 'arriveDate', 'arriveTime', 'note',
                             'remindAt', 'arrivedAt', 'arrivedBy', 'arrivedByName', 'updatedAt'])
        && s.type in ['flight', 'train', 'car', 'lodging', 'activity']
        && s.place is string && s.place.size() > 0 && s.place.size() <= 120
        && isDay(s.departDate)
        && (s.departTime == null || isClockTime(s.departTime))
        && (s.arriveDate == null || (isDay(s.arriveDate) && s.arriveDate >= s.departDate))
        && (s.arriveTime == null || isClockTime(s.arriveTime))
        && (s.note == null || (s.note is string && s.note.size() <= 1000))
        && (s.remindAt == null || s.remindAt is timestamp)
        && s.updatedAt == request.time
        && ((s.arrivedAt == null && s.arrivedBy == null && s.arrivedByName == null)
            || (s.arrivedAt is timestamp && s.arrivedBy is string && s.arrivedByName is string && s.remindAt == null));
    }

    // « Bien arrivé » is signed with the caller's own name, at the time of the server.
    function isMyArrivalNow(s) {
      return s.arrivedAt == request.time && s.arrivedBy == myMemberId() && s.arrivedByName == me().firstName;
    }

    function isParticipantOf(tripId) {
      return myMemberId() in tripOf(tripId).participantIds;
    }

    // trips/{tripId}/steps/{stepId}. The followers of the trip read the steps; each participant adds,
    // edits and deletes them, and says « bien arrivé » (or takes it back) for everyone of the trip.
    match /trips/{tripId}/steps/{stepId} {
      allow read: if isMember() && myMemberId() in tripOf(tripId).readerIds;

      allow create: if isMember()
        && isParticipantOf(tripId)
        && isValidStep(request.resource.data)
        && (request.resource.data.arrivedAt == null || isMyArrivalNow(request.resource.data));

      allow update: if isMember()
        && isParticipantOf(tripId)
        && isValidStep(request.resource.data)
        && (request.resource.data.arrivedAt == null
            || isMyArrivalNow(request.resource.data)
            || (request.resource.data.arrivedAt == resource.data.arrivedAt
                && request.resource.data.arrivedBy == resource.data.arrivedBy
                && request.resource.data.arrivedByName == resource.data.arrivedByName));

      allow delete: if isMember() && (isParticipantOf(tripId) || isOwner());
    }

    // --- App updates (lot 10) ---------------------------------------------------------------------

    // config/app: the latest version and the HTTPS link of its APK (docs/mise-a-jour.md).
    // config/family: { ownerMemberId }, the admin principal. Every member reads them. Nobody
    // writes them from the app: the workflow « APK de publication » writes config/app, and the workflow
    // « Créer le premier admin » writes config/family, neither bound by these rules.
    match /config/{docId} {
      allow read: if isMember() && docId in ['app', 'family'];
      allow write: if false;
    }

    // Everything else is closed until a lot opens it explicitly.
  }
}
