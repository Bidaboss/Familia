{
  "name": "familia-firebase",
  "private": true,
  "description": "Security rules tests for Familia, run against the Firestore emulator",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-familia \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.1.0",
    "firebase-tools": "^13.29.1"
  },
  "engines": {
    "node": ">=20"
  }
}
