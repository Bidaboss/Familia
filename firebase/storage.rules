rules_version = '2';

// Familia rules for Cloud Storage (photos of the trips, the good news, the comments). Nothing is
// readable or writable unless a module opens its own folder below, with a block of its own and
// tests in firebase/tests/storage.test.mjs. The rights come from Firestore, read with firestore.get,
// so a photo is never more visible than the document it belongs to.
//
// LIMIT: in production, one evaluation reads at most TWO different Firestore documents (the same
// document read again is free). memberEmails/{email} (isMember, myMemberId) is always one of them,
// so a rule may read only one other document on its way. The emulator does not enforce this: the
// tests pass even over the limit, and the real server then refuses every upload.
service firebase.storage {
  match /b/{bucket}/o {

    // --- Who is calling (the same checks as firestore.rules) ----------------------------------

    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function docPath(path) {
      return /databases/(default)/documents/$(path);
    }

    function emailIndexPath() {
      return docPath('memberEmails/' + request.auth.token.email.lower());
    }

    function isMember() {
      return hasVerifiedEmail() && firestore.exists(emailIndexPath());
    }

    function myMemberId() {
      return firestore.get(emailIndexPath()).data.memberId;
    }

    // --- What is sent --------------------------------------------------------------------------

    // A compressed JPEG made by the app (about 300 KB, or 30 KB for a thumbnail), never another file.
    function isJpegUnder(maxBytes) {
      return request.resource.contentType == 'image/jpeg'
        && request.resource.size > 0
        && request.resource.size <= maxBytes;
    }

    // --- Modules add their folder here, before the closing rule --------------------------------

    // Bonnes nouvelles (PRD, récit 32): goodNews/{authorId}/{postId}/{photoId}.jpg, about 300 KB, and
    // its thumbnail {photoId}-thumb.jpg, about 30 KB. The author sends the photos before writing
    // the document goodNews/{postId}, so the rules only check that the folder is theirs. A photo
    // is never replaced. The Cloud Function deletes the photos of a removed good news.
    match /goodNews/{authorId}/{postId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && postId.matches('^[A-Za-z0-9]{1,40}$')
        && ((fileName.matches('^[A-Za-z0-9_]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9_]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember() && authorId == myMemberId();
    }

    // Question de la semaine (PRD, récit 37): one optional photo per answer,
    // weeklyQuestions/{weekId}/{memberId}/{photoId}.jpg and its {photoId}-thumb.jpg, sent by the
    // member before the answer that names it. The Cloud Function deletes a photo once its answer
    // drops it or is removed.
    match /weeklyQuestions/{weekId}/{memberId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && resource == null
        && memberId == myMemberId()
        && weekId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && ((fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember() && memberId == myMemberId();
    }

    // Voyages (PRD, récit 15): trips/{tripId}/{authorId}/{slot}.jpg, about 300 KB, and its thumbnail
    // {slot}-thumb.jpg, about 30 KB, with a slot from 1 to 30 (30 photos per participant, see the
    // document trips/{tripId}/photos/{authorId}_{slot} in firestore.rules). The followers of the trip
    // see them. A participant sends their own before writing the document, and may send their own
    // slot again (the rule cannot also read the record: see LIMIT above). The author, the creator
    // of the trip or the admin principal removes them; deleting the trip removes them on the server.
    // An admin who is not the creator would read a third document: the app then removes the
    // record anyway, and the files go with the trip.
    function tripData(tripId) {
      return firestore.get(docPath('trips/' + tripId)).data;
    }

    // The owner of the family, as in firestore.rules (config/family.ownerMemberId).
    function isOwner() {
      return firestore.get(docPath('config/family')).data.ownerMemberId == myMemberId();
    }

    // « Une idée ? Un souci ? » (PRD, récit 6 sexies): one optional screenshot per request,
    // feedback/{authorId}/{feedbackId}.jpg, at most 150 KB, sent by its author just before the
    // document feedback/{feedbackId} that names it. Only the author and the admin principal see it,
    // as for the request. Either removes it with the request.
    match /feedback/{authorId}/{fileName} {
      allow read: if isMember() && (authorId == myMemberId() || isOwner());
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$')
        && isJpegUnder(150 * 1024);
      allow delete: if isMember() && (authorId == myMemberId() || isOwner());
    }

    match /trips/{tripId}/{authorId}/{fileName} {
      allow read: if isMember() && myMemberId() in tripData(tripId).readerIds;
      allow create, update: if isMember()
        && authorId == myMemberId()
        && myMemberId() in tripData(tripId).participantIds
        && ((fileName.matches('^([1-9]|[12][0-9]|30)[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^([1-9]|[12][0-9]|30)-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId() || tripData(tripId).creatorId == myMemberId() || isOwner());
    }

    // Album of an event (PRD, récit 41): events/{eventId}/{authorId}/{slot}.jpg and {slot}-thumb.jpg,
    // like the trips. Every member sees them; a member who said « je viens » sends their own from
    // the day of the event (checked by the record, see LIMIT above). The author, the
    // author of the event or the admin principal removes them.
    function eventData(eventId) {
      return firestore.get(docPath('events/' + eventId)).data;
    }


    match /events/{eventId}/{authorId}/{fileName} {
      allow read: if isMember();
      allow create, update: if isMember()
        && authorId == myMemberId()
        // Only the answer is read here (LIMIT above): the day of the event is checked by the rule
        // of the record in firestore.rules, so a file sent too early is never shown.
        && firestore.get(docPath('events/' + eventId + '/rsvps/' + myMemberId())).data.status == 'yes'
        && ((fileName.matches('^([1-9]|[12][0-9]|30)[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^([1-9]|[12][0-9]|30)-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId() || eventData(eventId).authorId == myMemberId() || isOwner());
    }

    // Plus de photos (PRD, récit 44): the cover of an event, events/{eventId}/cover/{authorId}/{photoId}.jpg
    // and its {photoId}-thumb.jpg. The member sends it to their own folder before writing its name in
    // the field coverPhoto of the event, where firestore.rules checks that they may change the event:
    // sending reads no other document (LIMIT above). A cover is never replaced, a new one has a new
    // name. Its sender removes it, and any member removes a cover that the event no longer names
    // (the old one, after a chef de famille changed it). The server removes them with the event.
    match /events/{eventId}/cover/{authorId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && ((fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId()
            || eventData(eventId).get('coverPhoto', null)
                != 'events/' + eventId + '/cover/' + authorId + '/' + fileName.split('[-.]')[0]);
    }

    // The image of a coup de main (récit 13, Kévin 16/11: the QR code of a parcel to pick up),
    // helpRequests/{requestId}/{authorId}/{photoId}.jpg and {photoId}-thumb.jpg. Sent to the
    // sender's own folder before its name goes in the field photo of the request, where
    // firestore.rules checks that they may write it. Only those who see the request (viewerIds,
    // PRODUIT-8) read it: the request is the one document read besides the caller (LIMIT above),
    // so not even the admin principal reads it outside them. Never replaced; its sender removes
    // it, and anyone removes an image the request no longer names. The server removes them with
    // the request.
    function helpRequestData(requestId) {
      return firestore.get(docPath('helpRequests/' + requestId)).data;
    }

    match /helpRequests/{requestId}/{authorId}/{fileName} {
      allow read: if isMember() && myMemberId() in helpRequestData(requestId).viewerIds;
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && ((fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId()
            || helpRequestData(requestId).get('photo', null)
                != 'helpRequests/' + requestId + '/' + authorId + '/' + fileName.split('[-.]')[0]);
    }

    // The photo of a bon plan (récit 45): goodDeals/{dealId}/{authorId}/{photoId}.jpg and its
    // {photoId}-thumb.jpg, sent to the sender's own folder before its name goes in the field photo
    // of the deal, where firestore.rules checks that they may write it. Every member reads it, as
    // the deal. Never replaced; its sender removes it, and anyone removes a photo the deal no longer
    // names. The server removes them with the deal.
    match /goodDeals/{dealId}/{authorId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && ((fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId()
            || firestore.get(docPath('goodDeals/' + dealId)).data.get('photo', null)
                != 'goodDeals/' + dealId + '/' + authorId + '/' + fileName.split('[-.]')[0]);
    }

    // Plus de photos (PRD, récit 44): the photo of a wish or an idea,
    // giftLists/{listId}/{folder}/{authorId}/{photoId}.jpg and its {photoId}-thumb.jpg. The rights
    // are those of the list, by the same function as canSeeList in firestore.rules (keep both
    // alike), on the list only (LIMIT above): the item is not read. « shared » holds the photos of
    // items the beneficiary sees, « hidden » those of ideas kept from them before the reveal; the
    // item names a photo of the right folder (isValidItemPhoto in firestore.rules). Its author
    // sends it, once the list exists, and removes it; the server removes the photos of an item
    // that drops them and of a deleted list.
    function giftList(listId) {
      return firestore.get(docPath('giftLists/' + listId)).data;
    }

    function canSeeList(l) {
      return l.kind == 'wishes'
        || (l.kind == 'ideas' && l.beneficiaryId != myMemberId())
        || myMemberId() in l.viewerIds
        || (l.beneficiaryId == myMemberId() && l.revealed == true);
    }

    function isKeptFromMe(l) {
      return l.beneficiaryId == myMemberId() && l.revealed != true;
    }

    match /giftLists/{listId}/{folder}/{authorId}/{fileName} {
      allow read: if isMember()
        && folder in ['shared', 'hidden']
        && canSeeList(giftList(listId))
        && (folder == 'shared' || !isKeptFromMe(giftList(listId)));
      allow create: if isMember()
        && resource == null
        && folder in ['shared', 'hidden']
        && authorId == myMemberId()
        && canSeeList(giftList(listId))
        && ((fileName.matches('^[A-Za-z0-9]{1,40}[.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[A-Za-z0-9]{1,40}-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember() && authorId == myMemberId();
    }

    // Capsule temporelle (PRD, récit 39): capsules/{authorId}/{capsuleId}/{n}.jpg and {n}-thumb.jpg,
    // n from 1 to 3, sent by the author before the document capsules/{capsuleId}. The author reads
    // them; the recipients only once the server opened the capsule. Deleting it removes them.
    match /capsules/{authorId}/{capsuleId}/{fileName} {
      // The capsule must be this author's too, so a folder can never borrow another one's opening.
      allow read: if isMember()
        && (authorId == myMemberId()
            || (firestore.get(docPath('capsules/' + capsuleId)).data.authorId == authorId
                && myMemberId() in firestore.get(docPath('capsules/' + capsuleId)).data.openedFor));
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && capsuleId.matches('^[A-Za-z0-9]{1,40}$')
        && ((fileName.matches('^[1-3][.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[1-3]-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember() && authorId == myMemberId();
    }

    // Carnet de recettes (PRD, récit 38): recipes/{recipeId}/{authorId}/{slot}.jpg and its
    // {slot}-thumb.jpg, with 3 places (1 to 3). Every member sees them; the author of the recipe or
    // the admin principal sends them (the rule reads only the recipe, see LIMIT above), and removes
    // them. Deleting the recipe removes them on the server.
    function recipeData(recipeId) {
      return firestore.get(docPath('recipes/' + recipeId)).data;
    }

    // « Qui est-ce ? » (récit 43): the old photo and its thumbnail, sent by its author before the
    // post, which must then be theirs. The server removes them with the post.
    match /whoIsIt/{authorId}/{postId}/{fileName} {
      allow read: if isMember();
      allow create: if isMember()
        && resource == null
        && authorId == myMemberId()
        && postId.matches('^[A-Za-z0-9]{1,40}$')
        && (!firestore.exists(docPath('whoIsIt/' + postId)) || firestore.get(docPath('whoIsIt/' + postId)).data.authorId == authorId)
        && ((fileName == 'photo.jpg' && isJpegUnder(512 * 1024))
            || (fileName == 'photo-thumb.jpg' && isJpegUnder(64 * 1024)));
      allow delete: if isMember() && (authorId == myMemberId() || isOwner());
    }

    match /recipes/{recipeId}/{authorId}/{fileName} {
      allow read: if isMember();
      allow create, update: if isMember()
        && authorId == myMemberId()
        && (recipeData(recipeId).authorId == myMemberId() || isOwner())
        && ((fileName.matches('^[1-3][.]jpg$') && isJpegUnder(512 * 1024))
            || (fileName.matches('^[1-3]-thumb[.]jpg$') && isJpegUnder(64 * 1024)));
      allow delete: if isMember()
        && (authorId == myMemberId() || recipeData(recipeId).authorId == myMemberId() || isOwner());
    }

    // --- Everything else is closed --------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
